{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "set -a; . ./.env; set +a; exec pnpm --filter @workflo/api dev"],
      "port": 4000
    },
    {
      "name": "ui-storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workflo/ui", "storybook"],
      "port": 6006
    },
    {
      "name": "portal",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workflo/portal", "dev"],
      "port": 3001
    },
    {
      "name": "workspace",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workflo/workspace", "dev"],
      "port": 3002
    },
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workflo/landing", "dev"],
      "port": 3000
    },
    {
      "name": "landing-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workflo/landing", "exec", "next", "start", "-p", "3005"],
      "port": 3005
    }
  ]
}
