# ===========================================
# WORKFLO.SPACE — Environment Variables
# Скопіюй у .env.local та заповни значення
# ===========================================

# ─── DATABASE ──────────────────────────────
DATABASE_URL="postgresql://workflo:password@localhost:5432/workflo"
DATABASE_URL_TEST="postgresql://workflo:password@localhost:5432/workflo_test"
POSTGRES_PORT=5432

# Server deploy (staging/prod)
DATABASE_URL_STAGING="postgresql://workflo_stg:password@localhost:5432/workflo_staging"
DATABASE_URL_PROD="postgresql://workflo_prod:password@localhost:5432/workflo_production"

# ─── AUTH ──────────────────────────────────
JWT_SECRET="change-this-to-a-random-64-char-string"
# Access-token TTL (plugins/jwt.ts; дефолт 15m). Refresh-TTL захардкожено 30 днів
# у auth/tokens.ts (REFRESH_TTL_DAYS) — env-змінної для нього НЕМА.
JWT_EXPIRES_IN="15m"

# Server deploy (staging/prod)
JWT_SECRET_STAGING="change-this-random-64-char-string"
JWT_SECRET_PROD="change-this-random-64-char-string"
JWT_REFRESH_SECRET_STAGING="change-this-random-64-char-string"
JWT_REFRESH_SECRET_PROD="change-this-random-64-char-string"

# ─── API ───────────────────────────────────
API_PORT=4000
API_HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="debug"

# ─── CORS / CSRF (через кому) ──────────────
# Used by BOTH the CORS plugin and the /auth/refresh CSRF guard (one allowlist —
# config/origins.ts). Unset in prod → falls back to the workflo defaults.
CORS_ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3002"
# Cookie domain for the refresh cookie (prod: share across *.workflo.space).
COOKIE_DOMAIN=""

# ─── MULTI-TENANCY / RLS (ADR-004 / ADR-007) ─
# Activate Postgres row-level security: connect the WEB process as the restricted
# workflo_app role (DATABASE_APP_URL) and flip RLS_ENFORCED. Both off by default —
# see docs/ENGINEERING_STANDARDS.md → "RLS rollout" before enabling in prod.
RLS_ENFORCED="false"
DATABASE_APP_URL=""
# Server deploy (staging/prod) — compose maps these into RLS_ENFORCED /
# DATABASE_APP_URL inside the api container (workflo_app role URL).
RLS_ENFORCED_STAGING="false"
DATABASE_APP_URL_STAGING=""
RLS_ENFORCED_PROD="false"
DATABASE_APP_URL_PROD=""
# Base domain for subdomain→tenant resolution (SaaS F5; e.g. workflo.space).
BASE_DOMAIN=""

# ─── CREDENTIALS VAULT (module 17) ─────────
# 32-byte base64 KEK: `openssl rand -base64 32`. Absent → vault + 2FA-setup (S9-01) 503
# (feature off), the rest of the API is unaffected. Suffixed names go in the
# server .env — compose maps them into CREDENTIALS_KEK_BASE64 in the container.
CREDENTIALS_KEK_BASE64=""
CREDENTIALS_KEK_BASE64_STAGING=""
CREDENTIALS_KEK_BASE64_PROD=""

# ─── GOOGLE OAUTH (S9 §E) ──────────────────
# Google Cloud Console → OAuth client (Web). Redirect URI must EXACTLY match
# CALLBACK_URL. All three unset → the Google button is hidden, routes 503.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_CALLBACK_URL="http://localhost:4000/auth/oauth/google/callback"
# Server deploy (staging/prod) — compose maps these into the api container.
GOOGLE_OAUTH_CLIENT_ID_STAGING=""
GOOGLE_OAUTH_CLIENT_SECRET_STAGING=""
GOOGLE_OAUTH_CLIENT_ID_PROD=""
GOOGLE_OAUTH_CLIENT_SECRET_PROD=""

# ─── SEED ──────────────────────────────────
# In production builds (NODE_ENV=production — i.e. the staging seed step) the seed
# REFUSES to run while these are unset: the well-known defaults are dev-only.
SEED_OWNER_EMAIL="owner@workflo.space"
SEED_OWNER_PASSWORD="Admin123!"
SEED_EXECUTOR_PASSWORD=""
SEED_CLIENT_PASSWORD=""

# ─── SMTP (Mailcow) ────────────────────────
SMTP_HOST="mailpit"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@workflo.space"
SMTP_FROM_NAME="Workflo"
# true → TLS-з'єднання (порт 465); false/absent → STARTTLS/plain (587/1025)
SMTP_SECURE="false"

# ─── TELEGRAM BOT ──────────────────────────
BOT_TOKEN="your-bot-token-from-botfather"
BOT_MODE="polling"
BOT_WEBHOOK_URL=""
BOT_WEBHOOK_SECRET=""
# Account linking (S6-05/06). USERNAME (no @) builds the t.me deep link; LINK_SECRET is the
# shared secret the bot uses to call POST /telegram/link; API_URL is how the bot reaches the API.
TELEGRAM_BOT_USERNAME="workflo_service_bot"
BOT_LINK_SECRET="generate-a-long-random-string"
BOT_API_URL="http://api:4000"

# ─── WEB PUSH (S9/NOTIFY, VAPID) ───────────
# `npx web-push generate-vapid-keys`. Не задано → push-канал мовчки вимкнений
# (тумблер у налаштуваннях повертає 503 на subscribe).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@workflo.space"

# ─── INBOUND EMAIL → ТІКЕТИ (S12-05) ───────
# IMAP-полер support-скриньки. Не задано → фіча off (no-op), нічого не ламається.
# Повна інструкція: docs/EMAIL_INBOUND_SETUP.md
INBOUND_IMAP_HOST=""
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=""
INBOUND_IMAP_PASSWORD=""
INBOUND_IMAP_SECURE="true"
INBOUND_IMAP_MAILBOX="INBOX"

# ─── ПУБЛІЧНІ ЛІНКИ / ВІДПИСКА (S12-05) ────
# База для публічних URL у листах (unsubscribe-лінк, публічний рахунок).
# Дефолт https://api.workflo.space — для staging/dev постав свій.
API_PUBLIC_URL=""
# HMAC-секрет unsubscribe-токенів; не задано → fallback на JWT_SECRET.
UNSUBSCRIBE_SECRET=""

# ─── PLATFORM ADMIN ────────────────────────
# auth/can.ts: email із superadmin-правами (крос-тенант /admin/*). Порожньо → нікого.
ADMIN_EMAIL=""

# ─── PDF (puppeteer) ───────────────────────
# Шлях до системного Chromium у контейнері; порожньо → бандлений chromium.
PUPPETEER_EXECUTABLE_PATH=""

# ─── WORKERS ───────────────────────────────
# "false" → api-процес НЕ запускає крони/outbox інлайн (окремий worker-процес).
# Дефолт (не задано) → інлайн у api. Див. apps/api/src/workers.ts.
RUN_WORKERS_INLINE=""

# ─── STORAGE ───────────────────────────────
# services/storage.ts читає STORAGE_DRIVER: "local" (дефолт) | "hetzner".
# УВАГА: hetzner-адаптер поки заглушка (S10-06 ⬜) — у MVP лише local.
STORAGE_DRIVER="local"
UPLOAD_DIR="/data/uploads"

# Hetzner Object Storage (Phase 2, залиш пустим в MVP — адаптер-заглушка)
HETZNER_ACCESS_KEY=""
HETZNER_SECRET_KEY=""
HETZNER_BUCKET=""
HETZNER_ENDPOINT=""
HETZNER_REGION=""

# ─── AI (генерація блогу, S7-05) ───────────
# services/blogAi.ts: без ключа AI-кнопка віддає 503 (фіча off), решта API працює.
ANTHROPIC_API_KEY=""
BLOG_AI_MODEL="claude-sonnet-5"

# ─── FRONTEND URLS (для API → frontend links в email/bot) ─
PORTAL_URL="http://localhost:3001"
WORKSPACE_URL="http://localhost:3002"
LANDING_URL="http://localhost:3000"

# ─── NEXT.JS LANDING ───────────────────────
NEXT_REVALIDATION_SECRET="change-this-random-string"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── VITE APPS (Portal + Workspace) ────────
VITE_API_URL="http://localhost:4000"

# ─── SENTRY ────────────────────────────────
SENTRY_DSN=""
SENTRY_DSN_LANDING=""
SENTRY_DSN_PORTAL=""
SENTRY_DSN_WORKSPACE=""

# ─── MONITORING ────────────────────────────
TELEGRAM_DEPLOY_CHAT_ID=""
TELEGRAM_DEPLOY_BOT_TOKEN=""

# ─── OFFSITE BACKUPS (INFRA-DR1, server .env) ─
# restic (рекомендовано: шифрований, дедуп, retention) АБО rclone (простий copy).
# Не задано → backup.sh голосно WARN'ить у лог+Telegram щоночі.
#   RESTIC_REPOSITORY="sftp:uXXXX@uXXXX.your-storagebox.de:/backups/workflo"
RESTIC_REPOSITORY=""
RESTIC_PASSWORD=""
RCLONE_REMOTE=""

# ─── DEPLOY METADATA ───────────────────────
GITHUB_REPOSITORY_OWNER="your-github-owner"
TEAM_IPS="127.0.0.1/32"
TRAEFIK_CERT_RESOLVER="cf"
TRAEFIK_NETWORK="traefik_network"
LANDING_TAG="sha-local"
PORTAL_TAG="sha-local"
WORKSPACE_TAG="sha-local"
API_TAG="sha-local"
BOT_TAG="sha-local"

# ─── PAYMENT SETTINGS ──────────────────────
# Реквізити для ручної оплати (зберігаються в БД через /settings/system)
# Не потрібні в ENV — вносяться через workspace UI
