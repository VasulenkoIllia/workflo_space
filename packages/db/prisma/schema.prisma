// ════════════════════════════════════════════════════════════════════════════
// Sprint 5 — Financial core (migration s5_00_financial_core). See docs/S5_PLAN.md.
// All tenant tables carry `agencyId` + get RLS `tenant_isolation` in the migration.
// ════════════════════════════════════════════════════════════════════════════

/// Bonus-account ledger (module 25). Append-only; `balanceAfter` is the running
/// balance snapshot computed under a FOR UPDATE lock on the company row.
model WalletTransaction {
  id           String          @id @default(uuid())
  agencyId     String
  agency       Agency          @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  type         WalletTxnType
  source       WalletTxnSource
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2)
  currency     String          @default("USD")
  sourceId     String?
  note         String?
  createdById  String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  @@index([companyId, createdAt])
  @@index([agencyId])
  @@map("wallet_transactions")
}

/// Money-account: links a confirmed payment to the charge(s) it settles (module 25).
model PaymentAllocation {
  id        String        @id @default(uuid())
  agencyId  String
  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  paymentId String
  payment   Payment       @relation(fields: [paymentId], references: [id])
  chargeId  String
  charge    ServiceCharge @relation(fields: [chargeId], references: [id])
  amount    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@index([agencyId])
  @@map("payment_allocations")
}

/// Per-agency referral % tiers (module 09/25). Editable; `tiers` = JSON tier table.
model ReferralSettings {
  id                      String   @id @default(uuid())
  agencyId                String   @unique
  agency                  Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  enabled                 Boolean  @default(true)
  tiers                   Json     @default("[]") // company-referral tiers (module 09)
  // 12-РЕФЕРАЛ-ПРАЦІВНИКА (P-9b, PROJECTS_SPEC §4.2): single flat % of a referred
  // client's net income paid to the employee who brought them (П4: one % per client).
  employeeReferralPercent Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
  updatedBy               String?

  @@map("referral_settings")
}

/// Audit trail of loyalty-tier changes (module 10). Append-only.
model LoyaltyTierHistory {
  id        String       @id @default(uuid())
  agencyId  String
  agency    Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromTier  LoyaltyTier?
  toTier    LoyaltyTier
  reason    String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([companyId, createdAt])
  @@index([agencyId])
  @@map("loyalty_tier_history")
}

/// Per-executor, per-period payroll settlement (module 12). One row per
/// (executor, period) → idempotent generation; status draft→approved→paid.
model ExecutorPayout {
  id                  String       @id @default(uuid())
  agencyId            String
  agency              Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  executorId          String
  period              String // 'YYYY-MM'
  baseSalary          Decimal      @default(0) @db.Decimal(10, 2)
  billableHours       Decimal      @default(0) @db.Decimal(8, 2)
  hourlyEarned        Decimal      @default(0) @db.Decimal(10, 2)
  commissionAmount    Decimal      @default(0) @db.Decimal(10, 2)
  // 12-РЕФЕРАЛ-ПРАЦІВНИКА (P-9b): % of net income from clients this executor referred
  // (PROJECTS_SPEC §4.2) — a separate payout line, recomputed with the rest of a draft.
  referralBonusAmount Decimal      @default(0) @db.Decimal(10, 2)
  total               Decimal      @default(0) @db.Decimal(10, 2)
  currency            String       @default("USD")
  status              PayoutStatus @default(draft)
  approvedBy          String?
  paidAt              DateTime?    @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)

  // AR-20 (audit 2026-06-11): tenant-scoped — a multi-agency staffer needs a payout
  // per agency for the same period (the global key collided with a row the other
  // agency cannot even see under RLS).
  @@unique([agencyId, executorId, period])
  @@index([agencyId])
  @@map("executor_payouts")
}

/// Operating expenses for P&L (module 22). `source=executor_rate` rows are derived
/// from ExecutorRate (salary) and must NOT duplicate a manual salary line.
model Expense {
  id          String            @id @default(uuid())
  agencyId    String
  agency      Agency            @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  type        ExpenseType
  category    ExpenseCategory
  source      ExpenseSource     @default(manual)
  vendor      String?
  amount      Decimal           @db.Decimal(10, 2)
  currency    String            @default("USD")
  frequency   ExpenseFrequency?
  startDate   DateTime          @db.Date
  endDate     DateTime?         @db.Date
  executorId  String?
  companyId   String?
  isActive    Boolean           @default(true)
  createdById String
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([agencyId, category])
  @@map("expenses")
}

/// Header-based request idempotency (module 05). One stored response per
/// (key, endpoint); replayed on retry. Swept after `expiresAt` (24h TTL).
/// `agencyId` is a plain column (RLS-scoped) — ephemeral, no FK relation needed.
model IdempotencyKey {
  key            String
  endpoint       String
  agencyId       String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)

  @@id([key, endpoint])
  @@index([expiresAt])
  @@index([agencyId])
  @@map("idempotency_keys")
}

/// Юр-особа агенції (20-Д, S5.6 P-1б). Реквізити для документів і договорів.
/// N на агенцію, ≥1 дефолтна (provisionAgency). Project.legalEntityId — у P-1.
model LegalEntity {
  id       String @id @default(uuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  name         String // внутрішня назва («ФОП Іваненко», «ТОВ Workflo»)
  legalType    String // 'fop' | 'tov' | 'individual' | 'foreign' (вільний — як Project.type, П8)
  legalName    String // повна юр-назва для документів
  taxId        String? // ЄДРПОУ / ІПН / РНОКПП
  vatPayer     Boolean @default(false) // платник ПДВ (звʼязок 05-Ж VAT-поля)
  vatId        String? // ІПН платника ПДВ
  legalAddress String?
  bankName     String?
  iban         String?
  signerName   String? // ПІБ, хто підписує
  signerTitle  String? // посада («директор», «ФОП»)
  stampUrl     String? // печатка/підпис (storage key)

  isDefault  Boolean  @default(false) // дефолтна юр-особа агенції (Юр-3 каскад)
  isComplete Boolean  @default(false) // обчислюється: legalName+taxId+iban+signerName (Юр-2 gate)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  documents Document[] // від якої юр-особи виставлено (Document.legalEntityId)
  projects  Project[] // 20-Д: проєкти, що виставляють від цієї юр-особи (Юр-3 каскад)

  @@unique([agencyId, name])
  @@index([agencyId])
  @@index([agencyId, isDefault])
  @@map("legal_entities")
}

/// Фінансовий проєкт клієнта (05-ПРОЕКТИ, S5.6 P-1). Контейнер фін-моделі між
/// Company та Orders/Charges: договір, валюта, цикл, ставки, маржа — все per-проєкт.
model Project {
  id        String  @id @default(uuid())
  agencyId  String
  agency    Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String // «Оренда», «Програмування», …
  type      String? // П8: вільний текст-категорія (довідник — на SaaS-фазі)

  billingModel     ProjectBillingModel
  currency         String              @default("USD") // per-проєкт (В3), НЕ Company.currency
  abonAmount       Decimal?            @db.Decimal(12, 2) // fixed_monthly_advance: сума абонплати за цикл
  clientHourlyRate Decimal?            @db.Decimal(10, 2) // hourly_*: клієнтська ставка

  billingCycle ProjectBillingCycle @default(monthly_day_n)
  cycleDay     Int? // 1..28 для monthly_day_n
  cycleWeekday Int? // 1..7 (ISO; 1=понеділок) для weekly_day_x
  nextCycleAt  DateTime?           @db.Timestamptz(3) // якір наступного закриття; null для manual

  paymentTermsDays Int? // 05-Г; null → дефолт компанії → дефолт агенції
  legalEntityId    String? // 20-Д: юр-особа агенції; null → дефолтна юр-особа (Юр-3)
  legalEntity      LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)

  contractRequired   Boolean @default(false) // дефолт залежить від billingModel (PROJECTS_SPEC §5)
  contractDocumentId String? // Document(type=contract) / завантажений підписаний

  requiresApproval Boolean? // 02-А (legacy, P-11 deprecates → approvalMode); null → дефолт компанії
  advanceGatePct   Decimal?         @db.Decimal(5, 2) // 02-В; для hourly_prepaid (і fixed — аванс 100%)
  // P-11 (PROJECTS_SPEC §8): per-project cost-approval override (null → inherit company → agency).
  // approvalMode supersedes the legacy requiresApproval boolean (upfront ≡ requiresApproval=true).
  approvalMode     ApprovalMode?
  invoiceApprover  InvoiceApprover?

  includedHoursCap Decimal? @db.Decimal(8, 2) // ГІБРИД: абонплата покриває N год; понад ліміт → clientHourlyRate. Генерація overage — P-2 cycle-engine

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  executorRates ProjectExecutorRate[]
  orders        Order[]
  charges       ServiceCharge[] // нарахування циклів (05-ПРОЕКТИ, P-1 3b)
  estimateLines EstimateLine[] // P-6: кошторис-позиції проєкту

  @@unique([companyId, name])
  @@index([agencyId])
  @@index([agencyId, active])
  @@index([companyId])
  @@index([legalEntityId])
  @@map("projects")
}

/// Override ставки-СОБІВАРТОСТІ виконавця на проєкті (12-А, S5.6 P-1). Без рядка —
/// fallback на персональну ставку працівника (ExecutorRate.hourlyRate — у P-5).
model ProjectExecutorRate {
  id             String   @id @default(uuid())
  agencyId       String
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executorId     String
  executor       Profile  @relation(fields: [executorId], references: [id], onDelete: Cascade)
  costHourlyRate Decimal? @db.Decimal(10, 2) // собівартість год на ЦЬОМУ проєкті
  currency       String   @default("USD")
  zeroCost       Boolean  @default(false) // 22: «без собівартості / весь дохід агенції»
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@unique([projectId, executorId])
  @@index([agencyId])
  @@map("project_executor_rates")
}

enum ProjectBillingModel {
  fixed_monthly_advance // абонплата; нарахування ЗАВЖДИ авансом на початку циклу
  hourly_prepaid // погодинка з авансом (гейт 02-В)
  hourly_postpaid // погодинка по факту: нарахування при закритті циклу
}

enum ProjectBillingCycle {
  monthly_day_n // кожного N-числа місяця (cycleDay)
  weekly_day_x // щотижня у день X (cycleWeekday)
  manual // «здав проєкт — закрив руками — сформував документи»
}

