}

model BillingPlan {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  priceUsd   Decimal  @db.Decimal(10, 2)
  maxOrders  Int?
  maxMembers Int?
  features   Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  agencies Agency[]

  @@map("billing_plans")
}

/// Agency SaaS subscription lifecycle (per-agency plan on workflo). Phase 0:
/// the platform agency sits in `active`; new external agencies start `trialing`.
enum AgencySubscriptionStatus {
  trialing
  active
  past_due
  canceled
  suspended
}

model Agency {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String?
  owner     Profile? @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // ── SaaS (ADR-004 Phase 1 / SAAS.md F1) — nullable forward-compat, unused
  //    until SaaS enablement; laid now so the live tenant table needs no later
  //    migration. `plan` references the existing BillingPlan catalog (not an enum).
  subdomain          String?                  @unique
  customDomain       String?                  @unique
  planId             String?
  plan               BillingPlan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionStatus AgencySubscriptionStatus @default(active)
  trialEndsAt        DateTime?                @db.Timestamptz(3)
  billingCustomerId  String?
  suspendedAt        DateTime?                @db.Timestamptz(3)
  limits             Json?

  // P-11 (PROJECTS_SPEC §8): agency-tier floor of the cost-approval cascade (non-null so
  // the cascade always terminates). Company/Project may override; null at those tiers inherits.
  defaultApprovalMode    ApprovalMode    @default(none)
  defaultInvoiceApprover InvoiceApprover @default(client)

  // 2FA-POLICY (рішення власника 05.07): when set, every INTERNAL member (owner/manager/
  // executor) must have TOTP 2FA. Grace = 7 days from this timestamp; past it, sessions
  // carry tfaDue and the API gate only lets /auth/* through until setup completes.
  // Portal clients are never affected. null = policy off.
  requireTwoFactorAt DateTime? @db.Timestamptz(3)

  // S11 scheduled email-звіти: owner-тумблер «місячний звіт на email». Cron шле
  // власникам дайджест за попередній місяць; lastSentAt гейтить одну відправку на місяць.
  monthlyReportEnabled          Boolean   @default(false)
  monthlyReportLastSentAt       DateTime? @db.Timestamptz(3)
  // 19-Г: місячний звіт КЛІЄНТАМ (PDF-документ + email) — окремий тумблер
  clientMonthlyReportEnabled    Boolean   @default(false)
  clientMonthlyReportLastSentAt DateTime? @db.Timestamptz(3)
  // 06-ПІДПИС: «без прийнятого договору робота не стартує» (рамковий договір компанії)
  requireSignedContract         Boolean   @default(false)
  // 06-А PDF-брендинг: лого (storage-key) + акцентний hex-колір на всіх PDF
  pdfLogoKey                    String?
  pdfAccentColor                String?
  // 05-Б дунінг: офсети кроків нагадувань від dueDate у днях (відʼємні = до терміну).
  // null → дефолтний ланцюжок [-3,0,3,7,14] (рішення власника 07.07); [] → дунінг вимкнено.
  dunningSteps                  Json?
  // АВТО-РАХУНОК (рішення власника 07.07): разове замовлення (без проекту) перейшло в
  // done → draft-invoice + in-app власнику. Увімкнено за замовчуванням.
  autoInvoiceOneTime            Boolean   @default(true)

  members           AgencyMember[]
  nomenclature      Nomenclature[]
  documentTemplates DocumentTemplate[]
  emailTemplates    EmailTemplate[]
  companies         Company[]
  orders            Order[]
  payments          Payment[]
  documents         Document[]
  serviceCharges    ServiceCharge[]
  orderComments     OrderComment[]
  orderFiles        OrderFile[]
  timeLogs          TimeLog[]
  services          Service[]
  executorRates     ExecutorRate[]
  auditLogs         AuditLog[]
  internalTasks     InternalTask[]
  activityLogs      ActivityLog[]
  invites           Invite[]
  documentCounters  DocumentCounter[]
  paymentSettings   PaymentSettings?
  exchangeRate      ExchangeRate?
  usageCounters     UsageCounter[]
  featureFlags      AgencyFeatureFlag[]
  tickets           Ticket[]
  calendarEvents    CalendarEvent[]

  // Sprint 5 — financial core
  walletTransactions   WalletTransaction[]
  paymentAllocations   PaymentAllocation[]
  referralSettings     ReferralSettings?
  loyaltyHistory       LoyaltyTierHistory[]
  executorPayouts      ExecutorPayout[]
  expenses             Expense[]
  referrals            Referral[] // AR-21 (S5.5)
  legalEntities        LegalEntity[] // 20-Д (S5.6 P-1б)
  projects             Project[] // 05-ПРОЕКТИ (S5.6 P-1)
  estimateLines        EstimateLine[] // 02-Б (S5.6 P-6)
  projectExecutorRates ProjectExecutorRate[] // 12-А (S5.6 P-1)
  leads                Lead[] // 26 (CRM)
  leadActivities       LeadActivity[] // 26-ТАЙМЛАЙН
  credentials          CredentialVault[] // 17-CREDENTIALS
  credentialShares     CredentialShare[] // 17-SHARE
  conversationStates   ConversationState[] // 18-Б
  orderTags            OrderTag[] // S10-01
  orderTagAssignments  OrderTagAssignment[] // S10-01
  orderTemplates       OrderTemplate[] // S10-01
  slaPolicies          SlaPolicy[] // S10-02

  @@index([planId])
  @@map("agencies")
}

model AgencyMember {
  id                  String           @id @default(uuid())
  agencyId            String
  agency              Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  profileId           String
  profile             Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role                AgencyMemberRole @default(executor)
  // 12-ПЛАН-ФАКТ (capacity norm): planned billable hours per week for this member.
  // null → the agency default (DEFAULT_WEEKLY_CAPACITY) is used in the hours report.
  weeklyCapacityHours Int?
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([agencyId, profileId])
  @@index([agencyId])
  @@index([profileId])
  @@map("agency_members")
}

enum AgencyMemberRole {
  owner
  manager // 20-А (MOD-4): orders/chats/clients — так; finance/settings — ні
  executor
}

/// Per-agency usage metering substrate for SaaS quotas/billing (SAAS.md F2/E4).
