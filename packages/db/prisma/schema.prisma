  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@id([agencyId, resource, period])
  @@index([agencyId])
  @@map("usage_counters")
}

/// Per-agency feature toggle (SAAS.md E7). Read by `featureEnabled()` once SaaS
