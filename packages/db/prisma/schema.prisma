generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               Role      @default(client)
  avatarUrl          String?
  language           Language  @default(uk)
  theme              Theme     @default(system)
  isActive           Boolean   @default(true)
  // Email ownership proven (S9 email-verify): set by /auth/verify-email, invite
  // accept (email-bound link) or password reset (mailbox-delivered link).
  // null = unverified. Login is NOT blocked; sensitive actions may gate on it.
  emailVerifiedAt    DateTime? @db.Timestamptz(3)
  // Last agency a multi-agency staffer chose via /auth/switch-agency (ADR-004).
  // Soft preference — always re-validated against current agencyMemberships at
  // login/refresh, so a stale/dangling value harmlessly falls back to the first.
  lastActiveAgencyId String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  companyMembership      CompanyMember[]
  ordersAssigned         Order[]               @relation("OrderAssignee")
  ordersCreated          Order[]               @relation("OrderCreatedBy")
  ordersApprovalDecided  Order[]               @relation("OrderApprovalDecidedBy")
  chargesApprovalDecided ServiceCharge[]       @relation("ChargeApprovalDecidedBy")
  internalTasksAssigned  InternalTask[]        @relation("InternalTaskAssignee")
  comments               OrderComment[]
  timeLogs               TimeLog[]
  notificationSettings   NotificationSettings?
  refreshTokens          RefreshToken[]
  invitesSent            Invite[]              @relation("InvitedBy")
  executorRates          ExecutorRate[]
  blogPosts              BlogPost[]
  uploadedFiles          OrderFile[]
  notifications          Notification[]
  activityLogsAsActor    ActivityLog[]
  paymentsConfirmed      Payment[]             @relation("PaymentConfirmedBy")
  otpTokens              OtpToken[]
  documentsCreated       Document[]            @relation("DocumentCreatedBy")
  documentsForExecutor   Document[]            @relation("DocumentExecutor")
  auditLogsAsActor       AuditLog[]
  agenciesOwned          Agency[]              @relation("AgencyOwner")
  agencyMemberships      AgencyMember[]
  orderChatReads         OrderChatRead[]
  projectExecutorRates   ProjectExecutorRate[] // 12-А (S5.6 P-1)
  credentialsCreated     CredentialVault[]     @relation("CredentialCreatedBy") // 17
  twoFactor              TwoFactorAuth? // S9-01
  oauthAccounts          OAuthAccount[] // S9 §E
  commentReactions       CommentReaction[] // S10

  @@index([role])
  @@map("profiles")
}

// Social login (S9, canon 01-auth §E). One row per linked external identity;
// (provider, providerAccountId) is the stable key Google/GitHub guarantee.
// email is a snapshot of the provider-side address at link time (display only).
model OAuthAccount {
  id                String   @id @default(uuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  email             String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, providerAccountId])
  @@index([profileId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  // Session identity (S9-02). familyId is stable across rotations — one familyId =
  // one device/session; rotation carries it (and firstIssuedAt) to the new row, so
  // the sessions UI shows a device once with its original sign-in time.
  familyId      String   @default(uuid())
  userAgent     String?
  ip            String?
  firstIssuedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([profileId])
  @@map("refresh_tokens")
}

model Invite {
  id          String     @id @default(uuid())
  agencyId    String?
  agency      Agency?    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email       String
  token       String     @unique @default(uuid())
  type        InviteType
  invitedById String
  invitedBy   Profile    @relation("InvitedBy", fields: [invitedById], references: [id])
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  permissions Json?
  expiresAt   DateTime   @db.Timestamptz(3)
  usedAt      DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  @@index([agencyId])
  @@index([email])
  @@index([invitedById])
  @@index([companyId])
  @@map("invites")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique @default(uuid())
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email])
  @@map("password_reset_tokens")
}

model Company {
  id                   String           @id @default(uuid())
  agencyId             String
  name                 String
  // AR-22 (audit 2026-06-11): per-agency unique (@@unique below) — two tenants may both
  // have an "acme" client. referralCode stays globally unique (uuid; agency-less lookup).
  slug                 String
  language             Language         @default(uk)
  currency             String           @default("USD")
  notes                String?
  // 05-Г / В10 (P-4): default net payment terms (days) for this client's projects —
  // cascade tier 2 (Project.paymentTermsDays → THIS → agency PaymentSettings). null → next tier.
  paymentTermsDays     Int?
  // P-11 (PROJECTS_SPEC §8): per-client cost-approval defaults — the knob the owner sets
  // once per client. null → inherit the agency floor. Project may override further.
  approvalMode         ApprovalMode?
  invoiceApprover      InvoiceApprover?
  loyaltyTier          LoyaltyTier      @default(new)
  tierOverride         LoyaltyTier? // manual tier pin; the recalc cron never clobbers it (module 10)
  totalSpent           Decimal          @default(0) @db.Decimal(12, 2)
  bonusBalance         Decimal          @default(0) @db.Decimal(12, 2)
  moneyBalance         Decimal          @default(0) @db.Decimal(12, 2) // money-account (AR/prepaid): Σ confirmed payments − Σ charges (module 25)
  referralCode         String           @unique @default(uuid())
  referredById         String? // company-referral (module 09): another Company that referred this one
  // 12-РЕФЕРАЛ-ПРАЦІВНИКА (P-9b): the EMPLOYEE who brought this client. Plain-String FK
  // to Profile (project convention: no back-relation on Profile). Drives the referral
  // bonus = net-income(client) × % accrued onto that employee's payout (PROJECTS_SPEC §4.2).
  referredByEmployeeId String?
  // 06-Б (P-3): the CLIENT's own legal requisites — the document "to" party (invoices/
  // acts). The client fills these in Portal; the agency reads them at generation time.
  // `legalIsComplete` (Юр-2 analog) gates S6 document generation, not work. One set per
  // client (single legal entity); multi-entity-per-client is out of scope. Mirrors the
  // agency-side LegalEntity (20-Д) field-for-field.
  legalType            String? // 'fop'|'tov'|'individual'|'foreign' (free, П8)
  legalName            String? // повна юр-назва для документів
  taxId                String? // ЄДРПОУ/ІПН/РНОКПП
  vatPayer             Boolean          @default(false)
  vatId                String?
  legalAddress         String?
  bankName             String?
  iban                 String?
  signerName           String?
  signerTitle          String?
  documentEmail        String? // primary recipient for invoice/act PDFs (06-Г)
  documentEmailCc      String? // optional бухгалтерія CC
  legalIsComplete      Boolean          @default(false) // legalName+taxId+iban+signerName
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  members            CompanyMember[]
  orders             Order[]
  charges            ServiceCharge[]
  payments           Payment[]
  referralsSent      Referral[]           @relation("ReferrerCompany")
  referralsReceived  Referral[]           @relation("ReferredCompany")
  documents          Document[]
  invites            Invite[]
  walletTransactions WalletTransaction[]
  loyaltyHistory     LoyaltyTierHistory[]
  projects           Project[] // 05-ПРОЕКТИ (S5.6 P-1)
  credentials        CredentialVault[] // 17-CREDENTIALS
  agency             Agency               @relation(fields: [agencyId], references: [id])

  @@unique([agencyId, slug])
  @@index([agencyId])
  @@index([referredByEmployeeId]) // P-9b: payout generation looks up an employee's referred clients
  @@map("companies")
}

model CompanyMember {
  id          String            @id @default(uuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profileId   String
  profile     Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role        CompanyMemberRole @default(member)
  permissions Json              @default("{}")
  joinedAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([companyId, profileId])
  @@index([companyId])
  @@index([profileId])
  @@index([profileId, role])
  @@map("company_members")
}

model Order {
  id                  String               @id @default(uuid())
  agencyId            String
  title               String
  description         String?
  type                OrderType            @default(client_order)
  priority            OrderPriority        @default(medium)
  companyId           String?
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assigneeId          String?
  assignee            Profile?             @relation("OrderAssignee", fields: [assigneeId], references: [id])
  createdById         String
  createdBy           Profile              @relation("OrderCreatedBy", fields: [createdById], references: [id])
  internalStatus      OrderInternalStatus  @default(new)
  clientStatus        OrderClientStatus    @default(in_progress)
  billingType         BillingType          @default(fixed)
  fixedPrice          Decimal?             @db.Decimal(10, 2)
  hourlyRate          Decimal?             @db.Decimal(10, 2)
  estimatedHours      Decimal?             @db.Decimal(8, 2)
  totalAmount         Decimal?             @db.Decimal(10, 2)
  currency            String               @default("USD")
  deadline            DateTime?            @db.Timestamptz(3)
  paidAt              DateTime?            @db.Timestamptz(3)
  deletedAt           DateTime?            @db.Timestamptz(3)
  onHoldReason        String?
  cancelledReason     String?
  // 02-А (S5.6 P-7): опційне погодження оцінки клієнтом. requiresApproval — snapshot ефективного
  // прапорця на момент створення (дефолт проєкту/компанії); approvalStatus null = не подано/не
  // потрібно; гейтить перехід → in_progress, поки клієнт не «Погодити». decidedBy/At + comment = audit.
  requiresApproval    Boolean              @default(false)
  approvalStatus      OrderApprovalStatus?
  approvalDecidedAt   DateTime?            @db.Timestamptz(3)
  approvalDecidedById String?
  approvalDecidedBy   Profile?             @relation("OrderApprovalDecidedBy", fields: [approvalDecidedById], references: [id], onDelete: SetNull)
  approvalComment     String? // коментар клієнта при відхиленні (або примітка при погодженні)
  // P-11 (PROJECTS_SPEC §8): resolved cost-approval mode snapshot at creation (immutable).
  // requiresApproval above stays = (approvalMode == upfront) for the existing 02-А gate.
  // approvedAmount = counter-offer (client OK'd a LOWER sum than quoted); the difference is
  // recorded as a concession (P-10 manualDiscount) so quoted vs final-billed are both visible.
  approvalMode        ApprovalMode         @default(none)
  approvedAmount      Decimal?             @db.Decimal(10, 2)
  // 05-ПРОЕКТИ (S5.6 P-1): опційна привʼязка до фін-проєкту (legacy-замовлення без проєкту валідні)
  projectId           String?
  project             Project?             @relation(fields: [projectId], references: [id])
  zeroBilled          Boolean              @default(false) // В12: задача в абонплаті — НЕ білиться, але час → собівартість
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)

  stages        OrderStage[]
  comments      OrderComment[]
  timeLogs      TimeLog[]
  files         OrderFile[]
  internalTasks InternalTask[]
  estimateLine  EstimateLine? // P-6: the estimate position this zeroBilled task was spawned from
  activityLogs  ActivityLog[]
  chatReads     OrderChatRead[]
  payments      Payment[]
  documents     Document[]
  agency        Agency          @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([agencyId])
  @@index([agencyId, internalStatus]) // workspace kanban / status filter (S2)
  @@index([agencyId, createdAt]) // tenant-scoped paginated list (S2)
  @@index([agencyId, companyId]) // client's company order list (S2)
  @@index([companyId])
  @@index([assigneeId])
  @@index([internalStatus])
  @@index([clientStatus])
  @@index([type])
  @@index([createdAt])
  @@index([createdById])
  @@index([deletedAt])
  @@index([projectId])
  @@map("orders")
}

model OrderStage {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      StageStatus @default(pending)
  position    Int
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([orderId, position])
  @@map("order_stages")
}

/// Per-(order, profile) read marker for unread counts in chat-hub (modules 03/18).
model OrderChatRead {
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @db.Timestamptz(3)

  @@id([orderId, profileId])
  @@index([profileId])
  @@map("order_chat_reads")
}

model OrderComment {
  id          String         @id @default(uuid())
  agencyId    String
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId    String
  author      Profile        @relation(fields: [authorId], references: [id])
  content     String
  isInternal  Boolean        @default(false)
  // 03-чат (S10-04, зріз 03.07): reply-to — self-relation; видалення оригіналу лишає
  // відповідь живою (SetNull → «повідомлення видалено» на фронті).
  replyToId   String?
  replyTo     OrderComment?  @relation("CommentReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     OrderComment[] @relation("CommentReply")
  // Вкладення: OrderFile-и замовлення, прив'язані до цього повідомлення (03.07).
  attachments OrderFile[]
  // S10 @mention: profile-ids згаданих учасників (сервер валідовує видимість:
  // клієнта не можна згадати у внутрішній нотатці). Масив, не relation.
  mentionIds  String[]       @default([])
  // 03-Г pin: ТЗ/реквізити/домовленості зверху чату. Пінить owner/команда;
  // клієнт бачить (публічні). null = не закріплено.
  pinnedAt    DateTime?      @db.Timestamptz(3)
  pinnedById  String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  // editedAt = ФАКТ правки (показ «(відредаговано)»); updatedAt — технічний (канон 03-B).
  editedAt    DateTime?      @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?      @db.Timestamptz(3)
  agency      Agency         @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  reactions CommentReaction[]

  @@index([agencyId])
  @@index([orderId, createdAt])
  @@index([orderId, isInternal])
  @@index([orderId, pinnedAt])
  @@index([authorId])
  @@index([replyToId])
  @@map("order_comments")
}

// Реакції на повідомлення чату (S10, канон 03-C). Емодзі валідовано проти
// REACTION_EMOJIS (@workflo/types) — технічний набір до дизайнерського пака.
model CommentReaction {
  id        String       @id @default(uuid())
  commentId String
  comment   OrderComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([commentId, profileId, emoji])
  @@index([commentId])
  @@map("comment_reactions")
}

model OrderFile {
  id         String        @id @default(uuid())
  agencyId   String
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy String
  uploader   Profile       @relation(fields: [uploadedBy], references: [id])
  filename   String
  storedAs   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  // 03-чат (03.07): файл, надісланий У ЧАТІ, лінкується до повідомлення. Файл лишається
  // звичайним OrderFile (видно в табі «Файли»); SetNull при видаленні коментаря.
  commentId  String?
  comment    OrderComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime?     @db.Timestamptz(3)
  agency     Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([commentId])
  @@index([agencyId])
  @@index([orderId])
  @@map("order_files")
}

model InternalTask {
  id         String             @id @default(uuid())
  agencyId   String
  orderId    String
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title      String
  assigneeId String?
  assignee   Profile?           @relation("InternalTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status     InternalTaskStatus @default(todo)
  position   Int                @default(0)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)
  agency     Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([agencyId])
  @@index([orderId])
  @@index([assigneeId])
  @@map("internal_tasks")
}

model TimeLog {
  id                 String    @id @default(uuid())
  agencyId           String
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  executorId         String
  executor           Profile   @relation(fields: [executorId], references: [id])
  hours              Decimal   @db.Decimal(5, 2)
  comment            String?
  date               DateTime  @db.Date
  // 02-orders T2 (фінд.#7): таймерна модель поверх ручного hours. startedAt set + endedAt null
  // = таймер біжить (1 активний на виконавця — серіалізується advisory-lock у сервісі, НЕ БД-
  // констрейнтом, щоб не ламати drift-gate). Обидва null = звичайний ручний запис (back-compat).
  startedAt          DateTime? @db.Timestamptz(3)
  endedAt            DateTime? @db.Timestamptz(3)
  // П5/П7 (P-5): снапшот резолвнутих ставок у МОМЕНТ логування — стабільна історія
  // маржі при зміні ставок. costRateUsd — собівартість години в USD за курсом на дату.
  clientRateSnapshot Decimal?  @db.Decimal(10, 2) // дохід/год (Project.clientHourlyRate; 0 для zeroBilled)
  costRateSnapshot   Decimal?  @db.Decimal(10, 2) // собівартість/год (каскад §2.3)
  costCurrency       String? // валюта costRateSnapshot
  costRateUsd        Decimal?  @db.Decimal(10, 2) // собівартість/год у USD (курс на дату, П7)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  agency             Agency    @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([agencyId])
  @@index([orderId])
  @@index([executorId])
  @@index([date])
  // active-timer lookup: the running row per executor (endedAt IS NULL)
  @@index([executorId, endedAt])
  @@map("time_logs")
}

// Lead/CRM (module 26). Tenant-scoped (RLS via agencyId). Plain-String FKs (assignee/company/
// convertedOrder) per project convention (no back-relations); set companyId+convertedOrderId on
// convert→order. Pipeline stage = LeadStatus enum (fixed-stage MVP).
model Lead {
  id               String     @id @default(uuid())
  agencyId         String
  name             String // client/company or deal name
  contactName      String?
  email            String?
  phone            String?
  source           String? // free: 'website'|'referral'|'telegram'|... (like Project.type)
  status           LeadStatus @default(new)
  estimatedValue   Decimal?   @db.Decimal(12, 2)
  currency         String     @default("USD")
  notes            String?
  assigneeId       String? // Profile (no relation, convention)
  companyId        String? // set on convert
  convertedOrderId String? // set on convert
  lostReason       String?
  position         Int        @default(0)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  agency           Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([agencyId, status])
  @@map("leads")
}

// 17-CREDENTIALS: envelope-encrypted secrets bound to a client company.
// AES-256-GCM; per-record DEK wrapped by a platform KEK held in env (CREDENTIALS_KEK_BASE64) —
// never in the DB, so a table leak alone ≠ credential compromise. Plain metadata (label/service/
// url/username/notes) is queryable; only the secret value is ciphertext. Access: agency OWNER
// only (executors never), enforced in the route; RLS scopes by agencyId like every tenant table.
model CredentialVault {
  id                String    @id @default(uuid())
  agencyId          String
  companyId         String
  label             String // "Bitrix24 admin", "FTP клієнта" — plain
  service           String? // "bitrix24"|"ftp"|"wordpress"|... — filter/icon
  url               String? // login URL — plain
  username          String? // plain (preview without reveal)
  encryptedDek      Bytes // DEK wrapped by KEK (AES-256-GCM)
  dekIv             Bytes // 12-byte IV for DEK wrap
  dekAuthTag        Bytes // 16-byte GCM tag for DEK wrap
  ciphertext        Bytes // secret encrypted with DEK
  ciphertextIv      Bytes // 12-byte IV for ciphertext
  ciphertextAuthTag Bytes // 16-byte GCM tag for ciphertext
  notes             String? // plain notes (no secrets!)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  createdById       String
  agency            Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy         Profile   @relation("CredentialCreatedBy", fields: [createdById], references: [id])

  @@index([agencyId])
  @@index([companyId, revokedAt])
  @@map("credential_vault")
}

// TOTP 2FA per profile (S9-01). The secret is KEK-encrypted with the SAME envelope
// scheme as the vault (17) — so 2FA needs CREDENTIALS_KEK_BASE64 set. A row exists
// only after setup starts; enabledAt null = pending (secret generated, first code
// not yet confirmed) and does NOT gate login. Backup codes are one-time bcrypt hashes.
model TwoFactorAuth {
  profileId         String    @id
  profile           Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  encryptedDek      Bytes
  dekIv             Bytes
  dekAuthTag        Bytes
  ciphertext        Bytes // base32 TOTP secret encrypted with DEK
  ciphertextIv      Bytes
  ciphertextAuthTag Bytes
  enabledAt         DateTime? @db.Timestamptz(3) // null = setup pending (does not gate login)
  backupCodes       String[]  @default([]) // remaining one-time codes, bcrypt-hashed
  lastTotpStep      Int? // last accepted TOTP step (replay guard, RFC 6238 §5.2)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@map("two_factor_auth")
}

model Service {
  id              String   @id @default(uuid())
  agencyId        String?
  name            String
  description     String?
  isActive        Boolean  @default(true)
  isRecurring     Boolean  @default(true) // recurring-subscription service vs one-off (module 05)
  defaultPriceUsd Decimal? @db.Decimal(10, 2) // catalog default price (reference; estimates — P-6)
  estimatedHours  Decimal? @db.Decimal(8, 2) // P-6 (17.06): hours this service «takes» — seeds an EstimateLine budget
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  agency        Agency?        @relation(fields: [agencyId], references: [id])
  estimateLines EstimateLine[] // P-6: estimate positions referencing this catalog service

  @@index([agencyId])
  @@map("services")
}

/// Estimate line / project budget position (05-ПРОЕКТИ 02-Б, P-6). A service × hours
/// on a Project's estimate; each line auto-spawns a zeroBilled kanban task (В12) where
/// the work is logged (hours → margin cost). Σ(hours) reconciles against
/// `Project.includedHoursCap` (soft indicator; overage billing is the P-2 cycle-engine).
model EstimateLine {
  id        String   @id @default(uuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId String? // catalog reference; null = free-text line
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name      String // denormalized label — stable in documents even if the service is renamed
  hours     Decimal  @db.Decimal(8, 2) // budgeted hours (the position's «time»)
  amount    Decimal? @db.Decimal(10, 2) // optional line price in the project currency (null/0 = zero-billed)
  // The zeroBilled task auto-created from this line. Deleting the line leaves the task
  // (real logged work); SetNull keeps the task if the line goes away.
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  position  Int      @default(0) // display order in the estimate
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([agencyId]) // FK scan
  @@index([projectId, position]) // getEstimate: filter by project + ORDER BY position
  @@index([serviceId]) // FK scan (service delete → SetNull)
  @@map("estimate_lines")
}

model ServiceCharge {
  id                   String               @id @default(uuid())
  agencyId             String
  companyId            String
  company              Company              @relation(fields: [companyId], references: [id])
  // 05-ПРОЕКТИ (S5.6 P-1 3b): нарахування походить З ПРОЄКТУ (CompanyService видалено).
  projectId            String? // нарахування циклу проєкту (manual-разові — без проєкту)
  project              Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  periodStart          DateTime?            @db.Date // межі циклу (для weekly `month` недостатньо)
  periodEnd            DateTime?            @db.Date
  kind                 String               @default("subscription") // 'subscription'|'hourly'|'overage' (P-2d): абон-аванс / погодинка / понадлімітне в одному періоді
  amount               Decimal              @db.Decimal(10, 2)
  baseAmount           Decimal?             @db.Decimal(10, 2) // pre-discount (module 10 loyalty)
  discountPct          Decimal?             @db.Decimal(5, 2) // auto loyalty-tier discount
  discountAmount       Decimal?             @db.Decimal(10, 2)
  // 05-З (P-10): one-time MANUAL discount applied ON TOP of loyalty (owner-granted on a
  // specific charge). Either/both a % of the post-loyalty net and/or a flat amount;
  // `manualDiscountAmount` is the resolved absolute reduction folded into `totalAmount`.
  manualDiscountPct    Decimal?             @db.Decimal(5, 2)
  manualDiscountAmount Decimal?             @db.Decimal(10, 2)
  totalAmount          Decimal?             @db.Decimal(10, 2) // post-discount amount owed (loyalty + manual)
  currency             String               @default("USD")
  uahRate              Decimal?             @db.Decimal(10, 4)
  month                DateTime             @db.Date
  status               ChargeStatus         @default(pending)
  dueDate              DateTime?            @db.Timestamptz(3)
  paidAt               DateTime?            @db.Timestamptz(3)
  // P-11 (PROJECTS_SPEC §8) — on_actuals invoice-approval gate. approvalStatus null = no gate
  // (counts as owed immediately, today's behavior); pending = draft, EXCLUDED from moneyBalance
  // / FIFO / revenue until released; approved = live; rejected = held, team revises. approvedAmount
  // = counter-offer (released at a lower sum than billed; difference folded via manualDiscount).
  approvalStatus       OrderApprovalStatus?
  approvalDecidedAt    DateTime?            @db.Timestamptz(3)
  approvalDecidedById  String?
  approvalDecidedBy    Profile?             @relation("ChargeApprovalDecidedBy", fields: [approvalDecidedById], references: [id], onDelete: SetNull)
  approvalComment      String?
  approvedAmount       Decimal?             @db.Decimal(10, 2)
  notes                String?
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  agency               Agency               @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]

  @@unique([projectId, periodStart, kind]) // ідемпотентність per-цикл; kind розрізняє абон+overage в одному періоді (P-2d)
  @@index([agencyId])
  @@index([companyId, month])
  @@index([projectId])
  @@map("service_charges")
}

model Payment {
  id                String        @id @default(uuid())
  agencyId          String
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id])
  orderId           String?
  order             Order?        @relation(fields: [orderId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")
  amountUsd         Decimal?      @db.Decimal(10, 2) // FX snapshot at confirm-time (USD base); immutable. Loyalty lifetime + P&L revenue read this.
  rateUsed          Decimal?      @db.Decimal(10, 4) // native→USD rate used for the snapshot (1 for USD-native)
  type              PaymentType   @default(final)
  status            PaymentStatus @default(confirmed)
  provider          String        @default("manual")
  providerPaymentId String?
  sourceType        String? // optional link to what this payment settles (e.g. 'charge')
  sourceId          String?
  paymentLink       String?
  paymentMethod     String?
  paymentReference  String?
  note              String?
  confirmedBy       String
  confirmer         Profile       @relation("PaymentConfirmedBy", fields: [confirmedBy], references: [id])
  confirmedAt       DateTime      @default(now()) @db.Timestamptz(3)
  agency            Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]

  // Webhook idempotency. Standard PG unique indexes treat each NULL as distinct, so
  // multiple manual rows (providerPaymentId=NULL) are INTENTIONALLY allowed. Do NOT
  // add NULLS NOT DISTINCT — it would reject existing manual payments.
  @@unique([provider, providerPaymentId])
  // Source-anchored idempotency for non-manual flows; manual rows leave source NULL
  // (NULLs distinct → still allowed). Manual dedup is via the IdempotencyKey table.
  @@unique([agencyId, sourceType, sourceId])
  @@index([agencyId])
  @@index([companyId])
  @@index([orderId])
  @@index([confirmedBy])
  @@index([confirmedAt])
  @@index([status])
  @@map("payments")
}

model PaymentSettings {
  id               String   @id @default(cuid())
  agencyId         String   @unique
  agency           Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bankName         String?
  iban             String?
  accountName      String?
  cryptoUsdt       String?
  notes            String?
  invoiceCurrency  String   @default("UAH")
  // 05-Г / В10 (P-4): agency-wide default net payment terms (days) — cascade tier 3
  // (Project → Company → THIS). null → charge keeps its billing-model default dueDate.
  paymentTermsDays Int?
  // 05-Е (P-8): currency the bonus wallet is denominated in. The ledger operates in USD
  // today (Company.bonusBalance); this is the declared setting — multi-currency wallet
  // enforcement is future.
  bonusCurrency    String   @default("USD")
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@map("payment_settings")
}

model ExecutorRate {
  id                String    @id @default(uuid())
  agencyId          String
  executorId        String
  executor          Profile   @relation(fields: [executorId], references: [id], onDelete: Cascade)
  monthlySalary     Decimal?  @db.Decimal(10, 2)
  hourlyRate        Decimal?  @db.Decimal(10, 2) // 12-КОМПЕНСАЦІЇ (P-5): БАЗОВА собівартість години (fallback каскаду §2.3)
  zeroCostDefault   Boolean   @default(false) // 22 (P-5): глобальна «нульова собівартість» (owner/партнери); каскад tier 3
  currency          String    @default("USD") // currency of monthlySalary/hourlyRate — needed for P&L (module 22)
  commissionPercent Decimal   @default(0) @db.Decimal(5, 2)
  effectiveFrom     DateTime  @default(now()) @db.Timestamptz(3) // rate validity window for historical P&L
  effectiveUntil    DateTime? @db.Timestamptz(3)
  hireDate          DateTime? @db.Timestamptz(3) // for leave accrual (module 23)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  agency            Agency    @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@unique([executorId, effectiveFrom]) // one rate row per (executor, validity-start); enables historical-rate windows (modules 19/22)
  @@index([agencyId])
  @@map("executor_rates")
}

model Referral {
  id          String   @id @default(uuid())
  // AR-21 (audit 2026-06-11): referrals are intra-agency only (S5-06 enforces it at
  // accrual) — the row carries the tenant explicitly so column-scoped RLS applies
  // instead of the weaker referrer-side-only join policy.
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  referrerId  String
  referrer    Company  @relation("ReferrerCompany", fields: [referrerId], references: [id])
  referredId  String
  referred    Company  @relation("ReferredCompany", fields: [referredId], references: [id])
  totalEarned Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  bonuses ReferralBonus[]

  @@unique([referrerId, referredId])
  @@index([agencyId])
  @@index([referrerId])
  @@index([referredId])
  @@map("referrals")
}

model ReferralBonus {
  id         String   @id @default(uuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id])
  amount     Decimal  @db.Decimal(10, 2)
  percent    Decimal  @db.Decimal(5, 2)
  sourceType String
  sourceId   String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([sourceType, sourceId]) // idempotency: a given source (payment/charge) accrues a referral bonus at most once (SPEC §5)
  @@index([referralId])
  @@map("referral_bonuses")
}

model NotificationSettings {
  id               String    @id @default(uuid())
  profileId        String    @unique
  profile          Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  language         Language  @default(uk)
