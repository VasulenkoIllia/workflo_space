generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(client)
  avatarUrl    String?
  language     Language @default(uk)
  theme        Theme    @default(system)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  companyMembership     CompanyMember[]
  ordersAssigned        Order[]               @relation("OrderAssignee")
  ordersCreated         Order[]               @relation("OrderCreatedBy")
  internalTasksAssigned InternalTask[]        @relation("InternalTaskAssignee")
  comments              OrderComment[]
  timeLogs              TimeLog[]
  notificationSettings  NotificationSettings?
  refreshTokens         RefreshToken[]
  invitesSent           Invite[]              @relation("InvitedBy")
  executorRate          ExecutorRate?
  blogPosts             BlogPost[]
  uploadedFiles         OrderFile[]
  notifications         Notification[]
  activityLogsAsActor   ActivityLog[]
  paymentsConfirmed     Payment[]             @relation("PaymentConfirmedBy")
  otpTokens             OtpToken[]
  documentsCreated      Document[]            @relation("DocumentCreatedBy")
  documentsForExecutor  Document[]            @relation("DocumentExecutor")
  auditLogsAsActor      AuditLog[]
  agenciesOwned         Agency[]              @relation("AgencyOwner")
  agencyMemberships     AgencyMember[]

  @@index([role])
  @@map("profiles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  @@index([profileId])
  @@map("refresh_tokens")
}

model Invite {
  id          String     @id @default(uuid())
  email       String
  token       String     @unique @default(uuid())
  type        InviteType
  invitedById String
  invitedBy   Profile    @relation("InvitedBy", fields: [invitedById], references: [id])
  companyId   String?
  permissions Json?
  expiresAt   DateTime   @db.Timestamptz(3)
  usedAt      DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  @@index([email])
  @@index([invitedById])
  @@map("invites")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique @default(uuid())
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email])
  @@map("password_reset_tokens")
}

model Company {
  id           String      @id @default(uuid())
  agencyId     String
  name         String
  slug         String      @unique
  language     Language    @default(uk)
  currency     String      @default("USD")
  notes        String?
  loyaltyTier  LoyaltyTier @default(new)
  totalSpent   Decimal     @default(0) @db.Decimal(12, 2)
  bonusBalance Decimal     @default(0) @db.Decimal(12, 2)
  referralCode String      @unique @default(uuid())
  referredById String?
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  members           CompanyMember[]
  orders            Order[]
  serviceAssigns    CompanyService[]
  charges           ServiceCharge[]
  payments          Payment[]
  referralsSent     Referral[]       @relation("ReferrerCompany")
  referralsReceived Referral[]       @relation("ReferredCompany")
  documents         Document[]
  agency            Agency           @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@map("companies")
}

model CompanyMember {
  id          String            @id @default(uuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profileId   String
  profile     Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role        CompanyMemberRole @default(member)
  permissions Json              @default("{}")
  joinedAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([companyId, profileId])
  @@index([companyId])
  @@index([profileId])
  @@map("company_members")
}

model Order {
  id              String              @id @default(uuid())
  agencyId        String?
  title           String
  description     String?
  type            OrderType           @default(client_order)
  priority        OrderPriority       @default(medium)
  companyId       String?
  company         Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assigneeId      String?
  assignee        Profile?            @relation("OrderAssignee", fields: [assigneeId], references: [id])
  createdById     String
  createdBy       Profile             @relation("OrderCreatedBy", fields: [createdById], references: [id])
  internalStatus  OrderInternalStatus @default(new)
  clientStatus    OrderClientStatus   @default(in_progress)
  billingType     BillingType         @default(fixed)
  fixedPrice      Decimal?            @db.Decimal(10, 2)
  hourlyRate      Decimal?            @db.Decimal(10, 2)
  estimatedHours  Decimal?            @db.Decimal(8, 2)
  totalAmount     Decimal?            @db.Decimal(10, 2)
  currency        String              @default("USD")
  deadline        DateTime?           @db.Timestamptz(3)
  paidAt          DateTime?           @db.Timestamptz(3)
  deletedAt       DateTime?           @db.Timestamptz(3)
  onHoldReason    String?
  cancelledReason String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  stages        OrderStage[]
  comments      OrderComment[]
  timeLogs      TimeLog[]
  files         OrderFile[]
  internalTasks InternalTask[]
  activityLogs  ActivityLog[]
  payments      Payment[]
  documents     Document[]
  agency        Agency?        @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([companyId])
  @@index([assigneeId])
  @@index([internalStatus])
  @@index([clientStatus])
  @@index([type])
  @@index([createdAt])
  @@index([createdById])
  @@index([deletedAt])
  @@map("orders")
}

model OrderStage {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      StageStatus @default(pending)
  position    Int
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([orderId, position])
  @@map("order_stages")
}

/// Per-(order, profile) read marker for unread counts in chat-hub (modules 03/18).
model OrderChatRead {
  orderId    String
  profileId  String
  lastReadAt DateTime @db.Timestamptz(3)

  @@id([orderId, profileId])
  @@index([profileId])
  @@map("order_chat_reads")
}

model OrderComment {
  id         String    @id @default(uuid())
  agencyId   String?
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId   String
  author     Profile   @relation(fields: [authorId], references: [id])
  content    String
  isInternal Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  editedAt   DateTime? @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)
  agency     Agency?   @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([orderId, createdAt])
  @@index([orderId, isInternal])
  @@index([authorId])
  @@map("order_comments")
}

model OrderFile {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy String
  uploader   Profile  @relation(fields: [uploadedBy], references: [id])
  filename   String
  storedAs   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@map("order_files")
}

model InternalTask {
  id         String             @id @default(uuid())
  orderId    String
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title      String
  assigneeId String?
  assignee   Profile?           @relation("InternalTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status     InternalTaskStatus @default(todo)
  position   Int                @default(0)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)

  @@index([orderId])
  @@index([assigneeId])
  @@map("internal_tasks")
}

model TimeLog {
  id         String   @id @default(uuid())
  agencyId   String?
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  executorId String
  executor   Profile  @relation(fields: [executorId], references: [id])
  hours      Decimal  @db.Decimal(5, 2)
  comment    String?
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  agency     Agency?  @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([orderId])
  @@index([executorId])
  @@index([date])
  @@map("time_logs")
}

model Service {
  id          String   @id @default(uuid())
  agencyId    String?
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  companyAssigns CompanyService[]
  agency         Agency?          @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@map("services")
}

model CompanyService {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  customPrice Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  charges ServiceCharge[]

  @@unique([companyId, serviceId])
  @@index([companyId])
  @@map("company_services")
}

model ServiceCharge {
  id               String         @id @default(uuid())
  agencyId         String?
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  companyServiceId String
  companyService   CompanyService @relation(fields: [companyServiceId], references: [id])
  amount           Decimal        @db.Decimal(10, 2)
  uahRate          Decimal?       @db.Decimal(10, 4)
  month            DateTime       @db.Date
  status           ChargeStatus   @default(pending)
  dueDate          DateTime?      @db.Timestamptz(3)
  paidAt           DateTime?      @db.Timestamptz(3)
  notes            String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  agency           Agency?        @relation(fields: [agencyId], references: [id])

  @@unique([companyServiceId, month])
  @@index([agencyId])
  @@index([companyId, month])
  @@map("service_charges")
}

model Payment {
  id                String        @id @default(uuid())
  agencyId          String?
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id])
  orderId           String?
  order             Order?        @relation(fields: [orderId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")
  type              PaymentType   @default(final)
  status            PaymentStatus @default(confirmed)
  provider          String        @default("manual")
  providerPaymentId String?
  paymentLink       String?
  paymentMethod     String?
  paymentReference  String?
  note              String?
  confirmedBy       String
  confirmer         Profile       @relation("PaymentConfirmedBy", fields: [confirmedBy], references: [id])
  confirmedAt       DateTime      @default(now()) @db.Timestamptz(3)
  agency            Agency?       @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([companyId])
  @@index([orderId])
  @@index([confirmedBy])
  @@index([confirmedAt])
  @@index([status])
  @@map("payments")
}

model PaymentSettings {
  id              String   @id @default(cuid())
  bankName        String?
  iban            String?
  accountName     String?
  cryptoUsdt      String?
  notes           String?
  invoiceCurrency String   @default("UAH")
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@map("payment_settings")
}

model ExecutorRate {
  id                String    @id @default(uuid())
  agencyId          String?
  executorId        String    @unique
  executor          Profile   @relation(fields: [executorId], references: [id], onDelete: Cascade)
  monthlySalary     Decimal?  @db.Decimal(10, 2)
  currency          String    @default("USD") // currency of monthlySalary — needed for P&L (module 22)
  commissionPercent Decimal   @default(0) @db.Decimal(5, 2)
  effectiveFrom     DateTime  @default(now()) @db.Timestamptz(3) // rate validity window for historical P&L
  effectiveUntil    DateTime? @db.Timestamptz(3)
  hireDate          DateTime? @db.Timestamptz(3) // for leave accrual (module 23)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  agency            Agency?   @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([executorId, effectiveFrom])
  @@map("executor_rates")
}

model Referral {
  id          String   @id @default(uuid())
  referrerId  String
  referrer    Company  @relation("ReferrerCompany", fields: [referrerId], references: [id])
  referredId  String
  referred    Company  @relation("ReferredCompany", fields: [referredId], references: [id])
  totalEarned Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  bonuses ReferralBonus[]

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
  @@map("referrals")
}

model ReferralBonus {
  id         String   @id @default(uuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id])
  amount     Decimal  @db.Decimal(10, 2)
  percent    Decimal  @db.Decimal(5, 2)
  sourceType String
  sourceId   String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([referralId])
  @@map("referral_bonuses")
}

model NotificationSettings {
  id               String    @id @default(uuid())
  profileId        String    @unique
  profile          Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  language         Language  @default(uk)
  telegramChatId   String?   @unique
  telegramLinkedAt DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  preferences NotificationPreference[]
  logs        NotificationLog[]

  @@map("notification_settings")
}

/// Matrix: settingsId × category × channel → enabled.
/// CRITICAL_EVENTS (auth/billing email) bypass this table via resolver logic.
model NotificationPreference {
  id         String               @id @default(uuid())
  settingsId String
  settings   NotificationSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  category   String // matches NotificationCategory in @workflo/types
  channel    String // matches NotificationChannel in @workflo/types
  enabled    Boolean              @default(true)
  updatedAt  DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([settingsId, category, channel])
  @@index([settingsId])
  @@map("notification_preferences")
}

/// Delivery log — every dispatch attempt (success/fail/skipped/rolled_up).
/// Used by rollup detection (≥3 events / 10s) and adapter retry tracking.
model NotificationLog {
  id             String               @id @default(uuid())
  settingsId     String
  settings       NotificationSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  event          String // matches NotificationEvent string literal
  channel        String // NotificationChannel
  status         String // 'sent' | 'failed' | 'skipped' | 'rolled_up'
  errorCode      String? // adapter-specific: 'blocked', 'invalid_chat', 'rate_limited', ...
  rollupTargetId String? // when status='rolled_up', points to the consolidated message log row
  metadata       Json?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  @@index([settingsId, createdAt])
  @@index([settingsId, event, createdAt]) // rollup detection window query
  @@map("notification_logs")
}

/// Audit log for can() denials, ownership transfers, credential reveals, etc.
/// Retention: 365 days (see docs/RETENTION.md).
model AuditLog {
  id           String   @id @default(uuid())
  agencyId     String?
  actorId      String?
  actor        Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String // e.g. 'order.create', 'company.transfer_ownership'
  resourceType String? // 'company' | 'order' | 'credentials' | ...
  resourceId   String?
  result       String // 'allowed' | 'denied' | 'error'
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  agency       Agency?  @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Transactional outbox event (ADR topic #2-3). Worker claims due rows
/// (FOR UPDATE SKIP LOCKED), runs the handler, and marks done/failed; on
/// failure it backs off (nextAttemptAt) until maxAttempts, then → dead (DLQ).
model OutboxEvent {
  id            String       @id @default(uuid())
  agencyId      String?
  type          String // domain event type, e.g. 'order.created', 'notification.dispatch'
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(8)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  processedAt   DateTime?    @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([agencyId])
  @@map("outbox_events")
}

model Notification {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([profileId, isRead])
  @@index([profileId, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId   String
  actor     Profile  @relation(fields: [actorId], references: [id])
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@map("activity_logs")
}

model Document {
  id          String         @id @default(uuid())
  agencyId    String?
  type        DocumentType
  number      String
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id])
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  status      DocumentStatus @default(draft)
  storedAs    String?
  sentAt      DateTime?      @db.Timestamptz(3)
  generatedAt DateTime       @default(now()) @db.Timestamptz(3)
  createdById String
  createdBy   Profile        @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  executorId  String?
  executor    Profile?       @relation("DocumentExecutor", fields: [executorId], references: [id])
  agency      Agency?        @relation(fields: [agencyId], references: [id])

  @@unique([companyId, type, number])
  @@index([agencyId])
  @@index([companyId])
  @@index([orderId])
  @@index([type])
  @@index([createdById])
  @@index([executorId])
  @@map("documents")
}

model DocumentCounter {
  type  DocumentType
  year  Int
  count Int          @default(0)

  @@id([type, year])
  @@map("document_counters")
}

model BlogPost {
  id          String       @id @default(uuid())
  slug        String       @unique
  type        BlogPostType
  titleUk     String
  titleEn     String
  excerptUk   String
  excerptEn   String
  contentUk   Json
  contentEn   Json
  tags        String[]
  authorId    String
  author      Profile      @relation(fields: [authorId], references: [id])
  published   Boolean      @default(false)
  featured    Boolean      @default(false)
  publishedAt DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([type, published])
  @@index([publishedAt])
  @@index([authorId])
  @@map("blog_posts")
}

model ContactForm {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  source    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([isRead, createdAt])
  @@map("contact_forms")
}

model ExchangeRate {
  id        String   @id @default("singleton")
  usdToUah  Decimal  @db.Decimal(10, 4)
  eurToUah  Decimal? @db.Decimal(10, 4)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  updatedBy String?

  @@map("exchange_rates")
}

model OtpToken {
  id        String     @id @default(uuid())
  profileId String
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  code      String
  purpose   OtpPurpose
  channel   OtpChannel
  expiresAt DateTime   @db.Timestamptz(3)
  usedAt    DateTime?  @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([profileId, purpose])
  @@map("otp_tokens")
}

model BillingPlan {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  priceUsd   Decimal  @db.Decimal(10, 2)
  maxOrders  Int?
  maxMembers Int?
  features   Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@map("billing_plans")
}

model Agency {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String?
  owner     Profile? @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members        AgencyMember[]
  companies      Company[]
  orders         Order[]
  payments       Payment[]
  documents      Document[]
  serviceCharges ServiceCharge[]
  orderComments  OrderComment[]
  timeLogs       TimeLog[]
  services       Service[]
  executorRates  ExecutorRate[]
  auditLogs      AuditLog[]

  @@map("agencies")
}

model AgencyMember {
  id        String           @id @default(uuid())
  agencyId  String
  agency    Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role      AgencyMemberRole @default(executor)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([agencyId, profileId])
  @@index([agencyId])
  @@index([profileId])
  @@map("agency_members")
}

enum AgencyMemberRole {
  owner
  executor
}

/// Transactional outbox (ADR topic #2-3): durable domain-event queue for
/// reliable notify / webhook / search-index delivery with retry + DLQ.
/// Producers INSERT in the same tx as the state change; a worker drains it.
enum OutboxStatus {
  pending
  processing
  done
  failed
  dead
}

enum Role {
  owner
  executor
  client
}

enum Language {
  uk
  en
}

enum Theme {
  light
  dark
  system
}

enum LoyaltyTier {
  new
  regular
  partner
  vip
}

enum CompanyMemberRole {
  owner
  member
}

enum OrderType {
