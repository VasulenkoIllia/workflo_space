generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                Role      @default(client)
  avatarUrl           String?
  language            Language  @default(uk)
  theme               Theme     @default(system)
  isActive            Boolean   @default(true)
  // Email ownership proven (S9 email-verify): set by /auth/verify-email, invite
  // accept (email-bound link) or password reset (mailbox-delivered link).
  // null = unverified. Login is NOT blocked; sensitive actions may gate on it.
  emailVerifiedAt     DateTime? @db.Timestamptz(3)
  // Last agency a multi-agency staffer chose via /auth/switch-agency (ADR-004).
  // Soft preference — always re-validated against current agencyMemberships at
  // login/refresh, so a stale/dangling value harmlessly falls back to the first.
  lastActiveAgencyId  String?
  // 01-Б lockout: лічильник невдалих логінів + прогресивний лок (5+ фейлів → 15·30·60 хв).
  // Успішний вхід скидає обидва. Generic 401 — існування локу не палимо.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)
  // 01-Г зміна email: нова адреса чекає підтвердження лінком (otp purpose=email_change).
  pendingEmail        String?
  // 01-Д: тимчасовий пароль → примусова зміна (знімається зміною пароля).
  mustChangePassword  Boolean   @default(false)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  companyMembership      CompanyMember[]
  ordersAssigned         Order[]                   @relation("OrderAssignee")
  ordersCreated          Order[]                   @relation("OrderCreatedBy")
  ordersApprovalDecided  Order[]                   @relation("OrderApprovalDecidedBy")
  chargesApprovalDecided ServiceCharge[]           @relation("ChargeApprovalDecidedBy")
  internalTasksAssigned  InternalTask[]            @relation("InternalTaskAssignee")
  comments               OrderComment[]
  ticketMessages         TicketMessage[]
  calendarEventsCreated  CalendarEvent[]           @relation("CalendarEventCreatedBy")
  calendarAttendee       CalendarAttendee[]        @relation("CalendarAttendee")
  orderCoAssignments     OrderAssignee[]           @relation("OrderCoAssignee")
  taskCoAssignments      InternalTaskAssignee[]    @relation("TaskCoAssignee")
  ordersSubmitted        Order[]                   @relation("OrderSubmittedBy")
  ordersAccepted         Order[]                   @relation("OrderAcceptedBy")
  orderSettlements       OrderExecutorSettlement[] @relation("OrderSettlementExecutor")
  timeLogs               TimeLog[]
  notificationSettings   NotificationSettings?
  refreshTokens          RefreshToken[]
  invitesSent            Invite[]                  @relation("InvitedBy")
  executorRates          ExecutorRate[]
  blogPosts              BlogPost[]
  uploadedFiles          OrderFile[]
  notifications          Notification[]
  activityLogsAsActor    ActivityLog[]
  paymentsConfirmed      Payment[]                 @relation("PaymentConfirmedBy")
  otpTokens              OtpToken[]
  documentsCreated       Document[]                @relation("DocumentCreatedBy")
  documentsForExecutor   Document[]                @relation("DocumentExecutor")
  auditLogsAsActor       AuditLog[]
  agenciesOwned          Agency[]                  @relation("AgencyOwner")
  agencyMemberships      AgencyMember[]
  orderChatReads         OrderChatRead[]
  projectExecutorRates   ProjectExecutorRate[] // 12-А (S5.6 P-1)
  credentialsCreated     CredentialVault[]         @relation("CredentialCreatedBy") // 17
  twoFactor              TwoFactorAuth? // S9-01
  oauthAccounts          OAuthAccount[] // S9 §E
  commentReactions       CommentReaction[] // S10

  @@index([role])
  @@map("profiles")
}

// Social login (S9, canon 01-auth §E). One row per linked external identity;
// (provider, providerAccountId) is the stable key Google/GitHub guarantee.
// email is a snapshot of the provider-side address at link time (display only).
model OAuthAccount {
  id                String   @id @default(uuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  email             String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, providerAccountId])
  @@index([profileId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  // Session identity (S9-02). familyId is stable across rotations — one familyId =
  // one device/session; rotation carries it (and firstIssuedAt) to the new row, so
  // the sessions UI shows a device once with its original sign-in time.
  familyId      String   @default(uuid())
  userAgent     String?
  ip            String?
  firstIssuedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([profileId])
  @@map("refresh_tokens")
}

model Invite {
  id          String     @id @default(uuid())
  agencyId    String?
  agency      Agency?    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email       String
  token       String     @unique @default(uuid())
  type        InviteType
  invitedById String
  invitedBy   Profile    @relation("InvitedBy", fields: [invitedById], references: [id])
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  permissions Json?
  expiresAt   DateTime   @db.Timestamptz(3)
  usedAt      DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  @@index([agencyId])
  @@index([email])
  @@index([invitedById])
  @@index([companyId])
  @@map("invites")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique @default(uuid())
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email])
  @@map("password_reset_tokens")
}

model Company {
  id                   String           @id @default(uuid())
  agencyId             String
  name                 String
  // AR-22 (audit 2026-06-11): per-agency unique (@@unique below) — two tenants may both
  // have an "acme" client. referralCode stays globally unique (uuid; agency-less lookup).
  slug                 String
  language             Language         @default(uk)
  currency             String           @default("USD")
  notes                String?
  // 05-Г / В10 (P-4): default net payment terms (days) for this client's projects —
  // cascade tier 2 (Project.paymentTermsDays → THIS → agency PaymentSettings). null → next tier.
  paymentTermsDays     Int?
  // 05-Б дунінг: «не надсилати цьому клієнту нагадування про оплату» (усна домовленість).
  // Вимикає ЛИШЕ листи/сповіщення — overdue-статус нарахувань ставиться незалежно.
  dunningOptOut        Boolean          @default(false)
  // P-11 (PROJECTS_SPEC §8): per-client cost-approval defaults — the knob the owner sets
  // once per client. null → inherit the agency floor. Project may override further.
  approvalMode         ApprovalMode?
  invoiceApprover      InvoiceApprover?
  loyaltyTier          LoyaltyTier      @default(new)
  tierOverride         LoyaltyTier? // manual tier pin; the recalc cron never clobbers it (module 10)
  totalSpent           Decimal          @default(0) @db.Decimal(12, 2)
  bonusBalance         Decimal          @default(0) @db.Decimal(12, 2)
  moneyBalance         Decimal          @default(0) @db.Decimal(12, 2) // money-account (AR/prepaid): Σ confirmed payments − Σ charges (module 25)
  referralCode         String           @unique @default(uuid())
  referredById         String? // company-referral (module 09): another Company that referred this one
  // 12-РЕФЕРАЛ-ПРАЦІВНИКА (P-9b): the EMPLOYEE who brought this client. Plain-String FK
  // to Profile (project convention: no back-relation on Profile). Drives the referral
  // bonus = net-income(client) × % accrued onto that employee's payout (PROJECTS_SPEC §4.2).
  referredByEmployeeId String?
  // 06-Б (P-3): the CLIENT's own legal requisites — the document "to" party (invoices/
  // acts). The client fills these in Portal; the agency reads them at generation time.
  // `legalIsComplete` (Юр-2 analog) gates S6 document generation, not work. One set per
  // client (single legal entity); multi-entity-per-client is out of scope. Mirrors the
  // agency-side LegalEntity (20-Д) field-for-field.
  legalType            String? // 'fop'|'tov'|'individual'|'foreign' (free, П8)
  legalName            String? // повна юр-назва для документів
  taxId                String? // ЄДРПОУ/ІПН/РНОКПП
  vatPayer             Boolean          @default(false)
  vatId                String?
  legalAddress         String?
  bankName             String?
  iban                 String?
  signerName           String?
  signerTitle          String?
  documentEmail        String? // primary recipient for invoice/act PDFs (06-Г)
  documentEmailCc      String? // optional бухгалтерія CC
  legalIsComplete      Boolean          @default(false) // legalName+taxId+iban+signerName
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  members            CompanyMember[]
  orders             Order[]
  charges            ServiceCharge[]
  payments           Payment[]
  referralsSent      Referral[]           @relation("ReferrerCompany")
  referralsReceived  Referral[]           @relation("ReferredCompany")
  documents          Document[]
  invites            Invite[]
  walletTransactions WalletTransaction[]
  loyaltyHistory     LoyaltyTierHistory[]
  projects           Project[] // 05-ПРОЕКТИ (S5.6 P-1)
  credentials        CredentialVault[] // 17-CREDENTIALS
  agency             Agency               @relation(fields: [agencyId], references: [id])
  tickets            Ticket[]
  calendarEvents     CalendarEvent[]

  @@unique([agencyId, slug])
  @@index([agencyId])
  @@index([referredByEmployeeId]) // P-9b: payout generation looks up an employee's referred clients
  @@map("companies")
}

model CompanyMember {
  id          String            @id @default(uuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profileId   String
  profile     Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role        CompanyMemberRole @default(member)
  permissions Json              @default("{}")
  joinedAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([companyId, profileId])
  @@index([companyId])
  @@index([profileId])
  @@index([profileId, role])
  @@map("company_members")
}

model Order {
  id                  String               @id @default(uuid())
  agencyId            String
  title               String
  description         String?
  type                OrderType            @default(client_order)
  priority            OrderPriority        @default(medium)
  companyId           String?
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assigneeId          String?
  assignee            Profile?             @relation("OrderAssignee", fields: [assigneeId], references: [id])
  createdById         String
  createdBy           Profile              @relation("OrderCreatedBy", fields: [createdById], references: [id])
  internalStatus      OrderInternalStatus  @default(new)
  clientStatus        OrderClientStatus    @default(in_progress)
  billingType         BillingType          @default(fixed)
  fixedPrice          Decimal?             @db.Decimal(10, 2)
  hourlyRate          Decimal?             @db.Decimal(10, 2)
  estimatedHours      Decimal?             @db.Decimal(8, 2)
  totalAmount         Decimal?             @db.Decimal(10, 2)
  currency            String               @default("USD")
  deadline            DateTime?            @db.Timestamptz(3)
  paidAt              DateTime?            @db.Timestamptz(3)
  deletedAt           DateTime?            @db.Timestamptz(3)
  onHoldReason        String?
  cancelledReason     String?
  // 02-А (S5.6 P-7): опційне погодження оцінки клієнтом. requiresApproval — snapshot ефективного
  // прапорця на момент створення (дефолт проєкту/компанії); approvalStatus null = не подано/не
  // потрібно; гейтить перехід → in_progress, поки клієнт не «Погодити». decidedBy/At + comment = audit.
  requiresApproval    Boolean              @default(false)
  approvalStatus      OrderApprovalStatus?
  approvalDecidedAt   DateTime?            @db.Timestamptz(3)
  approvalDecidedById String?
  approvalDecidedBy   Profile?             @relation("OrderApprovalDecidedBy", fields: [approvalDecidedById], references: [id], onDelete: SetNull)
  approvalComment     String? // коментар клієнта при відхиленні (або примітка при погодженні)
  // P-11 (PROJECTS_SPEC §8): resolved cost-approval mode snapshot at creation (immutable).
  // requiresApproval above stays = (approvalMode == upfront) for the existing 02-А gate.
  // approvedAmount = counter-offer (client OK'd a LOWER sum than quoted); the difference is
  // recorded as a concession (P-10 manualDiscount) so quoted vs final-billed are both visible.
  approvalMode        ApprovalMode         @default(none)
  approvedAmount      Decimal?             @db.Decimal(10, 2)
  // 05-ПРОЕКТИ (S5.6 P-1): опційна привʼязка до фін-проєкту (legacy-замовлення без проєкту валідні)
  projectId           String?
  project             Project?             @relation(fields: [projectId], references: [id])
  // 02-Б НОМЕНКЛАТУРА (рішення власника 07.07): офіційна позиція «згідно КВЕД» — саме її
  // назва друкується в рахунках/актах цього замовлення (вся сума одним рядком).
  nomenclatureId      String?
  nomenclature        Nomenclature?        @relation(fields: [nomenclatureId], references: [id], onDelete: SetNull)
  zeroBilled          Boolean              @default(false) // В12: задача в абонплаті — НЕ білиться, але час → собівартість
  // 18-В: відповідальний за тред (хто винен клієнту відповідь). Plain Profile id
  // (project convention); null = «авто» — UI трактує як першого assignee.
  chatOwnerId         String?
  // S10-02 SLA (спека 02-orders §C): дедлайни реакції, штамповані при створенні з SlaPolicy
  // пріоритету; firstRespondedAt = перший ПУБЛІЧНИЙ коментар команди; slaBreachedAt — cron.
  firstResponseDueAt  DateTime?            @db.Timestamptz(3)
  resolutionDueAt     DateTime?            @db.Timestamptz(3)
  firstRespondedAt    DateTime?            @db.Timestamptz(3)
  slaBreachedAt       DateTime?            @db.Timestamptz(3)
  // ПРИЙМАННЯ РОБОТИ (07.07): виконавець здає (in_progress→review), owner/manager приймає
  // (review→done, гейт ролей). submittedBy/acceptedBy — audit-хто. billableHours — год ДО
  // ВИСТАВЛЕННЯ клієнту (погодинне; null = факт Σ TimeLog). Пооб'єктна оплата виконавцям —
  // OrderExecutorSettlement. Факт (Σ TimeLog) ніколи не редагується — це правда/статистика.
  submittedAt         DateTime?            @db.Timestamptz(3)
  submittedById       String?
  submittedBy         Profile?             @relation("OrderSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  acceptedAt          DateTime?            @db.Timestamptz(3)
  acceptedById        String?
  acceptedBy          Profile?             @relation("OrderAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  billableHours       Decimal?             @db.Decimal(8, 2)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)

  stages             OrderStage[]
  comments           OrderComment[]
  timeLogs           TimeLog[]
  files              OrderFile[]
  internalTasks      InternalTask[]
  coAssignees        OrderAssignee[]
  settlements        OrderExecutorSettlement[] // ПРИЙМАННЯ: по-виконавцева звірка оплатних годин
  estimateLine       EstimateLine? // P-6: the estimate position this zeroBilled task was spawned from
  orderEstimateLines OrderEstimateLine[] // 02-Б: кошторис разового замовлення (qty × ціна)
  activityLogs       ActivityLog[]
  chatReads          OrderChatRead[]
  payments           Payment[]
  documents          Document[]
  conversationStates ConversationState[]
  tags               OrderTagAssignment[]
  agency             Agency                    @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([agencyId])
  @@index([agencyId, internalStatus]) // workspace kanban / status filter (S2)
  @@index([agencyId, createdAt]) // tenant-scoped paginated list (S2)
  @@index([agencyId, companyId]) // client's company order list (S2)
  @@index([companyId])
  @@index([assigneeId])
  @@index([internalStatus])
  @@index([clientStatus])
  @@index([type])
  @@index([createdAt])
  @@index([createdById])
  @@index([deletedAt])
  @@index([projectId])
  @@index([nomenclatureId])
  @@map("orders")
}

// 18-Б: per-user conversation state of an order thread. muted → the outbox worker drops
// chat.new_comment for this profile (mentions DELIBERATELY bypass mute); archivedAt →
// «архівні» розділ у майбутній секції «Чати». profileId — plain Profile id (convention).
model ConversationState {
  id           String    @id @default(uuid())
  agencyId     String
  profileId    String
  orderId      String
  muted        Boolean   @default(false)
  archivedAt   DateTime? @db.Timestamptz(3)
  // 18-Б snooze: до цього часу тред схований з основних фільтрів хабу; після —
  // повертається з ⏰-маркером. NULL = не відкладено.
  snoozedUntil DateTime? @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  agency       Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([profileId, orderId])
  @@index([orderId, muted])
  @@index([agencyId])
  @@map("conversation_state")
}

// S10-01: per-agency tag catalog for orders (спека 02-orders §B). Admin CRUD (owner);
// assignment — team, через join-таблицю нижче.
model OrderTag {
  id        String   @id @default(uuid())
  agencyId  String
  name      String
  color     String? // hex/токен для чіпа; null → нейтральний
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  assignments OrderTagAssignment[]

  @@unique([agencyId, name])
  @@index([agencyId])
  @@map("order_tags")
}

// agencyId продубльовано заради уніформного RLS (join-таблиці без tenant-колонки
// політикою wf_in_tenant не накриваються).
model OrderTagAssignment {
  orderId  String
  tagId    String
  agencyId String
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tag      OrderTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@id([orderId, tagId])
  @@index([tagId])
  @@index([agencyId])
  @@map("order_tag_assignments")
}

// S10-01: order creation presets (спека 02-orders §E). defaultStages/nomenclatureCode —
// spec-compat, поки не використовуються (стадії/номенклатура — окремі зрізи).
model OrderTemplate {
  id                 String      @id @default(uuid())
  agencyId           String
  name               String
  type               OrderType   @default(client_order)
  defaultTitle       String
  defaultDescription String?
  defaultBillingType BillingType @default(fixed)
  defaultPrice       Decimal?    @db.Decimal(10, 2)
  defaultStages      Json?
  nomenclatureCode   String?
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)
  agency             Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, name])
  @@index([agencyId])
  @@map("order_templates")
}

// S10-02: per-agency SLA-конфіг per-пріоритет (спека 02-orders §C). Хвилини до першої
// відповіді команди та до розв'язання; замовлення штампується дедлайнами при створенні.
model SlaPolicy {
  id                String        @id @default(uuid())
  agencyId          String
  priority          OrderPriority
  firstResponseMins Int
  resolutionMins    Int
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  agency            Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, priority])
  @@index([agencyId])
  @@map("sla_policies")
}

model OrderStage {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      StageStatus @default(pending)
  position    Int
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([orderId, position])
  @@map("order_stages")
}

/// Per-(order, profile) read marker for unread counts in chat-hub (modules 03/18).
model OrderChatRead {
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @db.Timestamptz(3)

  @@id([orderId, profileId])
  @@index([profileId])
  @@map("order_chat_reads")
}

model OrderComment {
  id          String         @id @default(uuid())
  agencyId    String
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId    String
  author      Profile        @relation(fields: [authorId], references: [id])
  content     String
  isInternal  Boolean        @default(false)
  // 03-чат (S10-04, зріз 03.07): reply-to — self-relation; видалення оригіналу лишає
  // відповідь живою (SetNull → «повідомлення видалено» на фронті).
  replyToId   String?
  replyTo     OrderComment?  @relation("CommentReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     OrderComment[] @relation("CommentReply")
  // Вкладення: OrderFile-и замовлення, прив'язані до цього повідомлення (03.07).
  attachments OrderFile[]
  // S10 @mention: profile-ids згаданих учасників (сервер валідовує видимість:
  // клієнта не можна згадати у внутрішній нотатці). Масив, не relation.
  mentionIds  String[]       @default([])
  // 03-Г pin: ТЗ/реквізити/домовленості зверху чату. Пінить owner/команда;
  // клієнт бачить (публічні). null = не закріплено.
  pinnedAt    DateTime?      @db.Timestamptz(3)
  pinnedById  String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  // editedAt = ФАКТ правки (показ «(відредаговано)»); updatedAt — технічний (канон 03-B).
  editedAt    DateTime?      @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?      @db.Timestamptz(3)
  agency      Agency         @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  reactions CommentReaction[]

  @@index([agencyId])
  @@index([orderId, createdAt])
  @@index([orderId, isInternal])
  @@index([orderId, pinnedAt])
  @@index([authorId])
  @@index([replyToId])
  @@map("order_comments")
}

// Реакції на повідомлення чату (S10, канон 03-C). Емодзі валідовано проти
// REACTION_EMOJIS (@workflo/types) — технічний набір до дизайнерського пака.
model CommentReaction {
  id        String       @id @default(uuid())
  commentId String
  comment   OrderComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([commentId, profileId, emoji])
  @@index([commentId])
  @@map("comment_reactions")
}

model OrderFile {
  id         String        @id @default(uuid())
  agencyId   String
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy String
  uploader   Profile       @relation(fields: [uploadedBy], references: [id])
  filename   String
  storedAs   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  // 03-чат (03.07): файл, надісланий У ЧАТІ, лінкується до повідомлення. Файл лишається
  // звичайним OrderFile (видно в табі «Файли»); SetNull при видаленні коментаря.
  commentId  String?
  comment    OrderComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime?     @db.Timestamptz(3)
  agency     Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([commentId])
  @@index([agencyId])
  @@index([orderId])
  @@map("order_files")
}

model InternalTask {
  id          String                 @id @default(uuid())
  agencyId    String
  orderId     String
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title       String
  assigneeId  String?
  assignee    Profile?               @relation("InternalTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status      InternalTaskStatus     @default(todo)
  position    Int                    @default(0)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(3)
  agency      Agency                 @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  coAssignees InternalTaskAssignee[]

  @@index([agencyId])
  @@index([orderId])
  @@index([assigneeId])
  @@map("internal_tasks")
}

// МУЛЬТИВИКОНАВЦІ (рішення власника 07.07): співвиконавці замовлення ДОДАТКОВО до
// головного (Order.assigneeId — «відповідальний», драйвить SLA/комісію/chat-owner/«мої»).
// Час засікає будь-який член команди (TimeLog.executorId per-рядок) — маржа/години вже multi.
model OrderAssignee {
  id        String   @id @default(uuid())
  agencyId  String
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation("OrderCoAssignee", fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([orderId, profileId])
  @@index([agencyId])
  @@index([profileId])
  @@map("order_assignees")
}

// ПРИЙМАННЯ (07.07): по-виконавцева звірка годин при прийманні замовлення. trackedHours —
// знімок Σ TimeLog виконавця на момент приймання; payableHours — скільки год фіксуємо ДО
// ОПЛАТИ виконавцю (owner/manager коригує; за замовч. = tracked). Джерело істини «оплатних
// годин» для майбутнього погодинного payroll + звітів; факт (Σ TimeLog) лишається окремо.
model OrderExecutorSettlement {
  id           String   @id @default(uuid())
  agencyId     String
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  profileId    String
  profile      Profile  @relation("OrderSettlementExecutor", fields: [profileId], references: [id], onDelete: Cascade)
  trackedHours Decimal  @default(0) @db.Decimal(8, 2)
  payableHours Decimal  @default(0) @db.Decimal(8, 2)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([orderId, profileId])
  @@index([agencyId])
  @@index([profileId])
  @@map("order_executor_settlements")
}

// Співвиконавці задачі (InternalTask) — аналогічно замовленню.
model InternalTaskAssignee {
  id        String       @id @default(uuid())
  agencyId  String
  taskId    String
  task      InternalTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile      @relation("TaskCoAssignee", fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([taskId, profileId])
  @@index([agencyId])
  @@index([profileId])
  @@map("internal_task_assignees")
}

model TimeLog {
  id                 String    @id @default(uuid())
  agencyId           String
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  executorId         String
  executor           Profile   @relation(fields: [executorId], references: [id])
  hours              Decimal   @db.Decimal(5, 2)
  comment            String?
  date               DateTime  @db.Date
  // 02-orders T2 (фінд.#7): таймерна модель поверх ручного hours. startedAt set + endedAt null
  // = таймер біжить (1 активний на виконавця — серіалізується advisory-lock у сервісі, НЕ БД-
  // констрейнтом, щоб не ламати drift-gate). Обидва null = звичайний ручний запис (back-compat).
  startedAt          DateTime? @db.Timestamptz(3)
  endedAt            DateTime? @db.Timestamptz(3)
  // П5/П7 (P-5): снапшот резолвнутих ставок у МОМЕНТ логування — стабільна історія
  // маржі при зміні ставок. costRateUsd — собівартість години в USD за курсом на дату.
  clientRateSnapshot Decimal?  @db.Decimal(10, 2) // дохід/год (Project.clientHourlyRate; 0 для zeroBilled)
  costRateSnapshot   Decimal?  @db.Decimal(10, 2) // собівартість/год (каскад §2.3)
  costCurrency       String? // валюта costRateSnapshot
  costRateUsd        Decimal?  @db.Decimal(10, 2) // собівартість/год у USD (курс на дату, П7)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  agency             Agency    @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([agencyId])
  @@index([orderId])
  @@index([executorId])
  @@index([date])
  // active-timer lookup: the running row per executor (endedAt IS NULL)
  @@index([executorId, endedAt])
  @@map("time_logs")
}

// Lead/CRM (module 26). Tenant-scoped (RLS via agencyId). Plain-String FKs (assignee/company/
// convertedOrder) per project convention (no back-relations); set companyId+convertedOrderId on
// convert→order. Pipeline stage = LeadStatus enum (fixed-stage MVP).
model Lead {
  id               String     @id @default(uuid())
  agencyId         String
  name             String // client/company or deal name
  contactName      String?
  email            String?
  phone            String?
  source           String? // free: 'website'|'referral'|'telegram'|... (like Project.type)
  status           LeadStatus @default(new)
  estimatedValue   Decimal?   @db.Decimal(12, 2)
  currency         String     @default("USD")
  notes            String?
  assigneeId       String? // Profile (no relation, convention)
  companyId        String? // set on convert
  convertedOrderId String? // set on convert
  lostReason       String?
  position         Int        @default(0)
  // 26-UTM: first-touch attribution captured on website intake (read-only in the app)
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  agency           Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  activities LeadActivity[]

  @@index([agencyId])
  @@index([agencyId, status])
  @@map("leads")
}

// 26-ТАЙМЛАЙН: append-only journal of lead lifecycle events (created / stage_changed /
// assigned / updated / converted). actorId is a plain Profile id (project convention,
// no FK); null actor = system intake (website contact form).
model LeadActivity {
  id        String   @id @default(uuid())
  agencyId  String
  leadId    String
  actorId   String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([agencyId])
  @@map("lead_activities")
}

// 17-CREDENTIALS: envelope-encrypted secrets bound to a client company.
// AES-256-GCM; per-record DEK wrapped by a platform KEK held in env (CREDENTIALS_KEK_BASE64) —
// never in the DB, so a table leak alone ≠ credential compromise. Plain metadata (label/service/
// url/username/notes) is queryable; only the secret value is ciphertext. Access: agency OWNER
// only (executors never), enforced in the route; RLS scopes by agencyId like every tenant table.
model CredentialVault {
  id                 String    @id @default(uuid())
  agencyId           String
  companyId          String
  label              String // "Bitrix24 admin", "FTP клієнта" — plain
  service            String? // "bitrix24"|"ftp"|"wordpress"|... — filter/icon
  url                String? // login URL — plain
  username           String? // plain (preview without reveal)
  // 17-Д typed templates: resourceType = key of VAULT_RESOURCE_TYPES (null = legacy freeform
  // row); publicFields = ordered non-secret fields [{kind,value}] (kinds from VAULT_FIELD_KINDS).
  // The SECRET fields of a typed card are stored as an encrypted JSON array in ciphertext below.
  resourceType       String?
  publicFields       Json?
  encryptedDek       Bytes // DEK wrapped by KEK (AES-256-GCM)
  dekIv              Bytes // 12-byte IV for DEK wrap
  dekAuthTag         Bytes // 16-byte GCM tag for DEK wrap
  ciphertext         Bytes // secret encrypted with DEK
  ciphertextIv       Bytes // 12-byte IV for ciphertext
  ciphertextAuthTag  Bytes // 16-byte GCM tag for ciphertext
  notes              String? // plain notes (no secrets!)
  // 17-РОТАЦІЯ (спека §D): optional access expiry; the daily cron nags the agency owner
  // when a secret is ≤7 days from (or past) expiresAt. rotationRemindedAt throttles the
  // reminder to once per 7 days per secret.
  expiresAt          DateTime? @db.Timestamptz(3)
  rotationRemindedAt DateTime? @db.Timestamptz(3)
  revokedAt          DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  createdById        String
  agency             Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  shares    CredentialShare[]
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy Profile           @relation("CredentialCreatedBy", fields: [createdById], references: [id])

  @@index([agencyId])
  @@index([companyId, revokedAt])
  @@map("credential_vault")
}

// 17-SHARE (спека §C + рішення власника 05.07): owner grants an EXECUTOR read/reveal access —
// either to ONE secret (credentialId set) or to ALL secrets of a client company (companyId set,
// covers future secrets too). Exactly one of the two targets is set (route-enforced). Grants are
// indefinite until revoked (owner decision 05.07); expiresAt is kept nullable for the spec's
// auto-expiry — the access check already honors it, but no UI/API sets it yet.
// executorId/grantedById are plain Profile ids (project convention, no FK).
model CredentialShare {
  id           String    @id @default(uuid())
  agencyId     String
  credentialId String?
  companyId    String?
  executorId   String
  grantedById  String
  revokedAt    DateTime? @db.Timestamptz(3)
  expiresAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  agency       Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  credential CredentialVault? @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([executorId, revokedAt])
  @@index([credentialId])
  @@index([agencyId, companyId])
  @@map("credential_shares")
}

// TOTP 2FA per profile (S9-01). The secret is KEK-encrypted with the SAME envelope
// scheme as the vault (17) — so 2FA needs CREDENTIALS_KEK_BASE64 set. A row exists
// only after setup starts; enabledAt null = pending (secret generated, first code
// not yet confirmed) and does NOT gate login. Backup codes are one-time bcrypt hashes.
model TwoFactorAuth {
  profileId         String    @id
  profile           Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  encryptedDek      Bytes
  dekIv             Bytes
  dekAuthTag        Bytes
  ciphertext        Bytes // base32 TOTP secret encrypted with DEK
  ciphertextIv      Bytes
  ciphertextAuthTag Bytes
  enabledAt         DateTime? @db.Timestamptz(3) // null = setup pending (does not gate login)
  backupCodes       String[]  @default([]) // remaining one-time codes, bcrypt-hashed
  lastTotpStep      Int? // last accepted TOTP step (replay guard, RFC 6238 §5.2)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@map("two_factor_auth")
}

model Service {
  id              String   @id @default(uuid())
  agencyId        String?
  name            String
  description     String?
  isActive        Boolean  @default(true)
  isRecurring     Boolean  @default(true) // recurring-subscription service vs one-off (module 05)
  defaultPriceUsd Decimal? @db.Decimal(10, 2) // catalog default price (reference; estimates — P-6)
  estimatedHours  Decimal? @db.Decimal(8, 2) // P-6 (17.06): hours this service «takes» — seeds an EstimateLine budget
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  agency             Agency?             @relation(fields: [agencyId], references: [id])
  estimateLines      EstimateLine[] // P-6: estimate positions referencing this catalog service
  orderEstimateLines OrderEstimateLine[] // 02-Б: позиції кошторисів замовлень

  @@index([agencyId])
  @@map("services")
}

// 02-Б НОМЕНКЛАТУРА (рішення власника 07.07): довідник офіційних позицій «згідно КВЕД»
// («Консультації з питань інформатизації»…). Обирається на замовленні/проекті — її назва
// друкується в рахунках і актах. vatRate ЗАКЛАДЕНО на майбутнє (05-Ж): розрахунок ПДВ
// свідомо не реалізований — поле поки що довідкове.
model Nomenclature {
  id        String   @id @default(uuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  code      String? // код КВЕД (довідково)
  vatRate   Decimal? @db.Decimal(5, 2) // % ПДВ; ПОКИ НЕ РАХУЄТЬСЯ (05-Ж на потім)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  orders   Order[]
  projects Project[]

  @@unique([agencyId, name])
  @@index([agencyId])
  @@map("nomenclature")
}

// 02-Б КОШТОРИС разового замовлення: позиція = послуга з каталогу АБО вільний рядок,
// кількість × ціна за одиницю. Σ позицій автоматично стає fixedPrice замовлення
// (одне джерело правди для погодження/авто-рахунку/PDF). Друкується ЛИШЕ у
// специфікації (довільний формат); рахунок/акт друкують номенклатуру.
model OrderEstimateLine {
  id        String   @id @default(uuid())
  agencyId  String
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId String? // каталожна послуга; null = вільний рядок
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name      String // денормалізована назва — стабільна в документах
  qty       Decimal  @db.Decimal(8, 2)
  unitPrice Decimal  @db.Decimal(10, 2)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([agencyId])
  @@index([orderId, position])
  @@index([serviceId])
  @@map("order_estimate_lines")
}

/// Estimate line / project budget position (05-ПРОЕКТИ 02-Б, P-6). A service × hours
/// on a Project's estimate; each line auto-spawns a zeroBilled kanban task (В12) where
/// the work is logged (hours → margin cost). Σ(hours) reconciles against
/// `Project.includedHoursCap` (soft indicator; overage billing is the P-2 cycle-engine).
model EstimateLine {
  id        String   @id @default(uuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId String? // catalog reference; null = free-text line
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name      String // denormalized label — stable in documents even if the service is renamed
  hours     Decimal  @db.Decimal(8, 2) // budgeted hours (the position's «time»)
  amount    Decimal? @db.Decimal(10, 2) // optional line price in the project currency (null/0 = zero-billed)
  // The zeroBilled task auto-created from this line. Deleting the line leaves the task
  // (real logged work); SetNull keeps the task if the line goes away.
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  position  Int      @default(0) // display order in the estimate
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([agencyId]) // FK scan
  @@index([projectId, position]) // getEstimate: filter by project + ORDER BY position
  @@index([serviceId]) // FK scan (service delete → SetNull)
  @@map("estimate_lines")
}

model ServiceCharge {
  id                   String               @id @default(uuid())
  agencyId             String
  companyId            String
  company              Company              @relation(fields: [companyId], references: [id])
  // 05-ПРОЕКТИ (S5.6 P-1 3b): нарахування походить З ПРОЄКТУ (CompanyService видалено).
  projectId            String? // нарахування циклу проєкту (manual-разові — без проєкту)
  project              Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  periodStart          DateTime?            @db.Date // межі циклу (для weekly `month` недостатньо)
  periodEnd            DateTime?            @db.Date
  kind                 String               @default("subscription") // 'subscription'|'hourly'|'overage' (P-2d): абон-аванс / погодинка / понадлімітне в одному періоді
  amount               Decimal              @db.Decimal(10, 2)
  baseAmount           Decimal?             @db.Decimal(10, 2) // pre-discount (module 10 loyalty)
  discountPct          Decimal?             @db.Decimal(5, 2) // auto loyalty-tier discount
  discountAmount       Decimal?             @db.Decimal(10, 2)
  // 05-З (P-10): one-time MANUAL discount applied ON TOP of loyalty (owner-granted on a
  // specific charge). Either/both a % of the post-loyalty net and/or a flat amount;
  // `manualDiscountAmount` is the resolved absolute reduction folded into `totalAmount`.
  manualDiscountPct    Decimal?             @db.Decimal(5, 2)
  manualDiscountAmount Decimal?             @db.Decimal(10, 2)
  totalAmount          Decimal?             @db.Decimal(10, 2) // post-discount amount owed (loyalty + manual)
  currency             String               @default("USD")
  uahRate              Decimal?             @db.Decimal(10, 4)
  month                DateTime             @db.Date
  status               ChargeStatus         @default(pending)
  dueDate              DateTime?            @db.Timestamptz(3)
  dunningLogs          DunningLog[]
  paidAt               DateTime?            @db.Timestamptz(3)
  // P-11 (PROJECTS_SPEC §8) — on_actuals invoice-approval gate. approvalStatus null = no gate
  // (counts as owed immediately, today's behavior); pending = draft, EXCLUDED from moneyBalance
  // / FIFO / revenue until released; approved = live; rejected = held, team revises. approvedAmount
  // = counter-offer (released at a lower sum than billed; difference folded via manualDiscount).
  approvalStatus       OrderApprovalStatus?
  approvalDecidedAt    DateTime?            @db.Timestamptz(3)
  approvalDecidedById  String?
  approvalDecidedBy    Profile?             @relation("ChargeApprovalDecidedBy", fields: [approvalDecidedById], references: [id], onDelete: SetNull)
  approvalComment      String?
  approvedAmount       Decimal?             @db.Decimal(10, 2)
  notes                String?
  // 05-В списання боргу (write-off): status='written_off' виключає з moneyBalance (AR-12);
  // тут — аудит хто/коли/чому. kind='credit_note' + негативний totalAmount = кредит-нота.
  writeOffReason       String?
  writtenOffAt         DateTime?            @db.Timestamptz(3)
  writtenOffById       String?
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  agency               Agency               @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]

  @@unique([projectId, periodStart, kind]) // ідемпотентність per-цикл; kind розрізняє абон+overage в одному періоді (P-2d)
  @@index([agencyId])
  @@index([companyId, month])
  @@index([projectId])
  @@map("service_charges")
}

// 05-Б дунінг: журнал надісланих нагадувань — ідемпотентність cron (один лист на крок
// на нарахування). escalatedAt = на цьому кроці пішла ескалація власнику.
model DunningLog {
  id          String        @id @default(uuid())
  agencyId    String
  chargeId    String
  charge      ServiceCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  stepOffset  Int
  escalatedAt DateTime?     @db.Timestamptz(3)
  sentAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([chargeId, stepOffset])
  @@index([agencyId])
  @@map("dunning_logs")
}

model Payment {
  id                String        @id @default(uuid())
  agencyId          String
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id])
  orderId           String?
  order             Order?        @relation(fields: [orderId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")
  amountUsd         Decimal?      @db.Decimal(10, 2) // FX snapshot at confirm-time (USD base); immutable. Loyalty lifetime + P&L revenue read this.
  rateUsed          Decimal?      @db.Decimal(10, 4) // native→USD rate used for the snapshot (1 for USD-native)
  type              PaymentType   @default(final)
  status            PaymentStatus @default(confirmed)
  provider          String        @default("manual")
  providerPaymentId String?
  sourceType        String? // optional link to what this payment settles (e.g. 'charge')
  sourceId          String?
  paymentLink       String?
  paymentMethod     String?
  paymentReference  String?
  note              String?
  confirmedBy       String
  confirmer         Profile       @relation("PaymentConfirmedBy", fields: [confirmedBy], references: [id])
  confirmedAt       DateTime      @default(now()) @db.Timestamptz(3)
  agency            Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]
  refunds     PaymentRefund[] // 05-В: повернення (повне/часткове)

  // Webhook idempotency. Standard PG unique indexes treat each NULL as distinct, so
  // multiple manual rows (providerPaymentId=NULL) are INTENTIONALLY allowed. Do NOT
  // add NULLS NOT DISTINCT — it would reject existing manual payments.
  @@unique([provider, providerPaymentId])
  // Source-anchored idempotency for non-manual flows; manual rows leave source NULL
  // (NULLs distinct → still allowed). Manual dedup is via the IdempotencyKey table.
  @@unique([agencyId, sourceType, sourceId])
  @@index([agencyId])
  @@index([companyId])
  @@index([orderId])
  @@index([confirmedBy])
  @@index([confirmedAt])
  @@index([status])
  @@map("payments")
}

// 05-В ПОВЕРНЕННЯ (рішення власника 07.07): повне або часткове повернення підтвердженого
// платежу. amountUsd — USD-знімок для moneyBalance (paid − Σ refunds для confirmed-платежів).
// Повне повернення (Σ refunds == payment.amountUsd) → Payment.status='refunded'.
model PaymentRefund {
  id           String   @id @default(uuid())
  agencyId     String
  paymentId    String
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(10, 2) // повернена сума (валюта платежу)
  amountUsd    Decimal? @db.Decimal(10, 2) // USD-знімок для балансу (курс платежу)
  reason       String?
  method       String? // як повернено (банк/готівка/…)
  refundedById String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([agencyId])
  @@index([paymentId])
  @@map("payment_refunds")
}

model PaymentSettings {
  id               String   @id @default(cuid())
  agencyId         String   @unique
  agency           Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bankName         String?
  iban             String?
  accountName      String?
  cryptoUsdt       String?
  notes            String?
  invoiceCurrency  String   @default("UAH")
  // 05-Г / В10 (P-4): agency-wide default net payment terms (days) — cascade tier 3
  // (Project → Company → THIS). null → charge keeps its billing-model default dueDate.
  paymentTermsDays Int?
  // 05-Е (P-8): currency the bonus wallet is denominated in. The ledger operates in USD
  // today (Company.bonusBalance); this is the declared setting — multi-currency wallet
  // enforcement is future.
  bonusCurrency    String   @default("USD")
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@map("payment_settings")
}

model ExecutorRate {
  id                String    @id @default(uuid())
  agencyId          String
  executorId        String
  executor          Profile   @relation(fields: [executorId], references: [id], onDelete: Cascade)
  monthlySalary     Decimal?  @db.Decimal(10, 2)
  hourlyRate        Decimal?  @db.Decimal(10, 2) // 12-КОМПЕНСАЦІЇ (P-5): собівартість години (каскад §2.3) + СТАВКА ОПЛАТИ погодинника (payout hourlyEarned, 07.07 S5-D6)
  zeroCostDefault   Boolean   @default(false) // 22 (P-5): глобальна «нульова собівартість» (owner/партнери); каскад tier 3
  currency          String    @default("USD") // currency of monthlySalary/hourlyRate — needed for P&L (module 22)
  commissionPercent Decimal   @default(0) @db.Decimal(5, 2)
  effectiveFrom     DateTime  @default(now()) @db.Timestamptz(3) // rate validity window for historical P&L
  effectiveUntil    DateTime? @db.Timestamptz(3)
  hireDate          DateTime? @db.Timestamptz(3) // for leave accrual (module 23)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  agency            Agency    @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@unique([executorId, effectiveFrom]) // one rate row per (executor, validity-start); enables historical-rate windows (modules 19/22)
  @@index([agencyId])
  @@map("executor_rates")
}

model Referral {
  id          String   @id @default(uuid())
  // AR-21 (audit 2026-06-11): referrals are intra-agency only (S5-06 enforces it at
  // accrual) — the row carries the tenant explicitly so column-scoped RLS applies
  // instead of the weaker referrer-side-only join policy.
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  referrerId  String
  referrer    Company  @relation("ReferrerCompany", fields: [referrerId], references: [id])
  referredId  String
  referred    Company  @relation("ReferredCompany", fields: [referredId], references: [id])
  totalEarned Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  bonuses ReferralBonus[]

  @@unique([referrerId, referredId])
  @@index([agencyId])
  @@index([referrerId])
  @@index([referredId])
  @@map("referrals")
}

model ReferralBonus {
  id         String   @id @default(uuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id])
  amount     Decimal  @db.Decimal(10, 2)
  percent    Decimal  @db.Decimal(5, 2)
  sourceType String
  sourceId   String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([sourceType, sourceId]) // idempotency: a given source (payment/charge) accrues a referral bonus at most once (SPEC §5)
  @@index([referralId])
  @@map("referral_bonuses")
}

model NotificationSettings {
  id               String    @id @default(uuid())
  profileId        String    @unique
  profile          Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  language         Language  @default(uk)
  telegramChatId   String?   @unique
  telegramLinkedAt DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  preferences NotificationPreference[]
  logs        NotificationLog[]

  @@map("notification_settings")
}

/// Matrix: settingsId × category × channel → enabled.
/// CRITICAL_EVENTS (auth/billing email) bypass this table via resolver logic.
model NotificationPreference {
  id         String               @id @default(uuid())
  settingsId String
  settings   NotificationSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  category   String // matches NotificationCategory in @workflo/types
  channel    String // matches NotificationChannel in @workflo/types
  enabled    Boolean              @default(true)
  updatedAt  DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([settingsId, category, channel])
  @@index([settingsId])
  @@map("notification_preferences")
}

/// Delivery log — every dispatch attempt (success/fail/skipped/rolled_up).
/// Used by rollup detection (≥3 events / 10s) and adapter retry tracking.
model NotificationLog {
  id             String               @id @default(uuid())
  settingsId     String
  settings       NotificationSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  event          String // matches NotificationEvent string literal
  channel        String // NotificationChannel
  status         String // 'sent' | 'failed' | 'skipped' | 'rolled_up'
  errorCode      String? // adapter-specific: 'blocked', 'invalid_chat', 'rate_limited', ...
  rollupTargetId String? // when status='rolled_up', points to the consolidated message log row
  metadata       Json?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  @@index([settingsId, createdAt])
  @@index([settingsId, event, createdAt]) // rollup detection window query
  @@map("notification_logs")
}

/// Audit log for can() denials, ownership transfers, credential reveals, etc.
/// Retention: 365 days (see docs/RETENTION.md).
model AuditLog {
  id           String   @id @default(uuid())
  agencyId     String?
  actorId      String?
  actor        Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String // e.g. 'order.create', 'company.transfer_ownership'
  resourceType String? // 'company' | 'order' | 'credentials' | ...
  resourceId   String?
  result       String // 'allowed' | 'denied' | 'error'
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  agency       Agency?  @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Transactional outbox event (ADR topic #2-3). Worker claims due rows
/// (FOR UPDATE SKIP LOCKED), runs the handler, and marks done/failed; on
/// failure it backs off (nextAttemptAt) until maxAttempts, then → dead (DLQ).
model OutboxEvent {
  id            String       @id @default(uuid())
  agencyId      String?
  type          String // domain event type, e.g. 'order.created', 'notification.dispatch'
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(8)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  processedAt   DateTime?    @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([agencyId])
  @@map("outbox_events")
}

model Notification {
  id           String    @id @default(uuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type         String
  title        String
  body         String
  isRead       Boolean   @default(false)
  metadata     Json?
  // 18-Б snooze: «повернути непрочитаною о T». GET ліниво скидає прострочені
  // (isRead=false, snoozedUntil=null) — без крона.
  snoozedUntil DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([profileId, isRead])
  @@index([profileId, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(uuid())
  agencyId  String
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId   String
  actor     Profile  @relation(fields: [actorId], references: [id])
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([agencyId])
  @@index([orderId, createdAt])
  @@map("activity_logs")
}

model Document {
  id               String         @id @default(uuid())
  agencyId         String
  type             DocumentType
  number           String
  orderId          String?
  order            Order?         @relation(fields: [orderId], references: [id])
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  status           DocumentStatus @default(draft)
  storedAs         String?
  sentAt           DateTime?      @db.Timestamptz(3)
  // 06-ПІДПИС: прийняття клієнтом (typed signature) — ПІБ/час/IP/акаунт.
  // acceptedById — plain Profile id (project convention, без FK).
  acceptedAt       DateTime?      @db.Timestamptz(3)
  acceptedById     String?
  acceptedByName   String?
  acceptedIp       String?
  // 06-ДОГОВІР-2: договір, підписаний поза системою (власний номер + дата +
  // файл у storedAs або посилання). Одразу accepted.
  signedExternally Boolean        @default(false)
  contractDate     DateTime?      @db.Timestamptz(3)
  externalUrl      String?
  generatedAt      DateTime       @default(now()) @db.Timestamptz(3)
  createdById      String
  createdBy        Profile        @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  executorId       String?
  executor         Profile?       @relation("DocumentExecutor", fields: [executorId], references: [id])
  agency           Agency         @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  legalEntityId    String? // 20-Д: від якої юр-особи агенції виставлено (резолв каскадом у S6)
  legalEntity      LegalEntity?   @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)

  @@unique([companyId, type, number])
  @@index([agencyId])
  @@index([companyId])
  @@index([orderId])
  @@index([type])
  @@index([createdById])
  @@index([executorId])
  @@index([legalEntityId])
  @@map("documents")
}

model DocumentCounter {
  agencyId String
  agency   Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  type     DocumentType
  year     Int
  count    Int          @default(0)

  @@id([agencyId, type, year])
  @@map("document_counters")
}

// 06-А (рішення власника 06.07): per-agency шаблони документів. body JSONB:
// contract → {sections:[{title,body}]} з {{змінними}}; інші типи → {note?, purpose?}.
// Один шаблон на тип (v1); нема рядка = системний шаблон (2-рівнева резолюція).
model DocumentTemplate {
  id          String       @id @default(uuid())
  agencyId    String
  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  type        DocumentType
  body        Json
  updatedById String? // plain Profile id (project convention)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([agencyId, type])
  @@index([agencyId])
  @@map("document_templates")
}

// 08-EMAIL (рішення власника 06.07): owner-override листів — ТЕМА + ВСТУПНИЙ ТЕКСТ
// поверх системного макета, окремо uk/en, лише бізнес-листи (auth — системні).
// event — NotificationEvent-ключ або псевдо-ключ ('reports.client_monthly').
model EmailTemplate {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  event       String
  locale      String // 'uk' | 'en'
  subject     String?
  intro       String?
  updatedById String? // plain Profile id (project convention)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([agencyId, event, locale])
  @@index([agencyId])
  @@map("email_templates")
}

model BlogPost {
  id          String       @id @default(uuid())
