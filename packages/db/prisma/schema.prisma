  one_time
}

enum ExpenseCategory {
  infrastructure
  software
  salary
  contractor
  rent
  tax
  marketing
  other
}

enum ExpenseSource {
  manual
  executor_rate
}

enum ExpenseFrequency {
  monthly
  quarterly
  annual
  one_time
}

enum ChargeFrequency {
  monthly
  quarterly
  annual
}
