# Server-side env file template for /var/www/srv/workflo/staging/.env and /var/www/srv/workflo/production/.env

# Use lowercase (GHCR requires lowercase repository path)
GITHUB_REPOSITORY_OWNER=your-github-owner

LANDING_TAG=sha-initial
PORTAL_TAG=sha-initial
WORKSPACE_TAG=sha-initial
API_TAG=sha-initial
BOT_TAG=sha-initial

DATABASE_URL_STAGING=postgresql://workflo_stg:password@localhost:5432/workflo_staging
DATABASE_URL_PROD=postgresql://workflo_prod:password@localhost:5432/workflo_production

JWT_SECRET_STAGING=replace-with-random-64-char
JWT_SECRET_PROD=replace-with-random-64-char

SMTP_HOST=mail.workflo.space
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

BOT_TOKEN=
OPENAI_API_KEY=
SENTRY_DSN=

TEAM_IPS=127.0.0.1/32
TRAEFIK_CERT_RESOLVER=cf
TRAEFIK_NETWORK=traefik_network
LOG_LEVEL=info
TELEGRAM_DEPLOY_CHAT_ID=
TELEGRAM_DEPLOY_BOT_TOKEN=
